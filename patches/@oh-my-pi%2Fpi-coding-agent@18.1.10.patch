index 0000000000000000000000000000000000000000..6bbba5cf876717ac2d6d0412f1a1a81f6f469bc0
--- /dev/null
+++ b/src/tools/browser/owned-cdp-transport.ts
@@ -0,0 +1,298 @@
+import type { Browser, ConnectionTransport } from "puppeteer-core";
+import type { CdpBrowser } from "puppeteer-core/internal/cdp/Browser.js";
+import type { Connection } from "puppeteer-core/internal/cdp/Connection.js";
+import { CdpCDPSession } from "puppeteer-core/internal/cdp/CdpSession.js";
+import { CDPSessionEvent } from "puppeteer-core/internal/api/CDPSession.js";
+import { TargetCloseError } from "puppeteer-core/internal/common/Errors.js";
+
+export interface OwnedCdpTransport extends ConnectionTransport {
+	/** Copied parent-owned receipts, available even after disposal rejects. */
+	readonly startupCreations: readonly StartupCreationOutcome[];
+	/** Stop tracking new creations only once every startup creation has a known target. */
+	finishStartup(): void;
+	/** Retire synchronously, then join original-session detach and all dispatched requests. */
+	dispose(): Promise<void>;
+}
+
+export type StartupCreationOutcome = Readonly<{ requestId: number } & (
+	| { status: "pending" }
+	| { status: "created"; targetId: string }
+	| { status: "unknown"; error: string }
+)>;
+
+const MAX_PENDING = 256;
+const MAX_STARTUP_CREATIONS = 256;
+const MAX_BUFFERED_EVENTS = 256;
+const MAX_BUFFERED_BYTES = 16 * 1024 * 1024;
+type Listener = (...args: any[]) => void;
+type Events = { on(event: string | symbol, listener: Listener): unknown; off(event: string | symbol, listener: Listener): unknown };
+type SessionRecord = { session: CdpCDPSession; removers: Array<() => void> };
+type StartupCreationRecord = { outcome: StartupCreationOutcome; settled: Promise<void> };
+
+/**
+ * Additive native-CDP prerequisite. The worker must later consume this through
+ * connect({ transport }); relay needs a separate owner-bound session adapter.
+ * This never opens an endpoint or transfers/disposes the parent's connection.
+ */
+export async function captureOwnedCdpTransport(browser: Browser, timeoutMs: number): Promise<OwnedCdpTransport> {
+	if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new Error("Invalid owned CDP transport timeout");
+	const source = browser as unknown as Pick<CdpBrowser, "_connection">;
+	const connection = source._connection;
+	const current = () => {
+		if (!connection || connection._closed || !browser.connected || source._connection !== connection) {
+			throw new Error("Original browser transport connection is unavailable");
+		}
+	};
+	current();
+	const existing = new Set(connection._sessions.keys());
+	let allocated: string | undefined;
+	try {
+		const result = await connection.send("Target.attachToBrowserTarget", undefined, { timeout: timeoutMs });
+		if (!result || typeof result.sessionId !== "string" || !result.sessionId || existing.has(result.sessionId)) {
+			throw new Error("Invalid owned browser session allocation");
+		}
+		allocated = result.sessionId;
+		current();
+		let root = connection._session(allocated);
+		if (!root) {
+			root = new CdpCDPSession(connection, "browser", allocated, undefined, true);
+			connection._sessions.set(allocated, root);
+		}
+		if (root.connection() !== connection || root.detached) throw new Error("Original browser session is unavailable");
+		const transport = new BrowserWorkerTransport(connection, root, current, timeoutMs);
+		allocated = undefined; // The transport now owns even partial listener setup cleanup.
+		try { transport.start(); return transport; }
+		catch (error) {
+			try { await transport.dispose(); }
+			catch (cleanupError) { throw new AggregateError([error, cleanupError], "Owned browser transport setup and cleanup failed"); }
+			throw error;
+		}
+	} catch (error) {
+		if (allocated) {
+			const failures: unknown[] = [error];
+			const session = connection._session(allocated);
+			try {
+				if (!connection._closed) await connection.send("Target.detachFromTarget", { sessionId: allocated }, { timeout: timeoutMs });
+			} catch (cleanupError) { failures.push(cleanupError); }
+			try { if (session && !session.detached) session.onClosed(); } catch (cleanupError) { failures.push(cleanupError); }
+			if (connection._session(allocated) === session) connection._sessions.delete(allocated);
+			if (failures.length > 1) throw new AggregateError(failures, "Owned browser session allocation and cleanup failed");
+		}
+		throw error;
+	}
+}
+
+class BrowserWorkerTransport implements OwnedCdpTransport {
+	readonly #sessions = new Map<string, SessionRecord>();
+	readonly #retiredChildren = new WeakSet<CdpCDPSession>();
+	readonly #requests = new Map<number, Promise<void>>();
+	readonly #startupCreations: StartupCreationRecord[] = [];
+	#trackingStartup = true;
+	readonly #failures: unknown[] = [];
+	#buffer: string[] = [];
+	#bufferBytes = 0;
+	#closed = false;
+	#closeNotified = false;
+	#disposal: Promise<void> | undefined;
+	#message: ((message: string) => void) | undefined;
+	#close: (() => void) | undefined;
+	readonly #connection: Connection;
+	readonly #root: CdpCDPSession;
+	readonly #current: () => void;
