index 0000000000000000000000000000000000000000..f3f9a54ccc9283780a4e0aee617ba0687268aea9
--- /dev/null
+++ b/src/mcp/resource-subscriptions.ts
@@ -0,0 +1,81 @@
+import type { MCPRequestOptions, MCPServerConnection } from "./types";
+
+export interface MCPResourceSubscription { release(): Promise<void> }
+interface Entry {
+  managed: boolean;
+  owners: Set<symbol>;
+  state: boolean | "unknown";
+  pending: boolean;
+  target: boolean;
+  tail: Promise<void>;
+}
+const connections = new WeakMap<MCPServerConnection, Map<string, Entry>>();
+function entryFor(connection: MCPServerConnection, uri: string): Entry {
+  if (!connection.capabilities.resources?.subscribe) throw new Error("The MCP server does not support resource subscriptions.");
+  if (!uri || uri.length > 16_384 || uri.includes("\0")) throw new Error("Invalid MCP resource URI.");
+  let entries = connections.get(connection);
+  if (!entries) { entries = new Map(); connections.set(connection, entries); }
+  let entry = entries.get(uri);
+  if (!entry) {
+    if (entries.size >= 4096) throw new Error("MCP resource subscription limit exceeded.");
+    entry = { managed: false, owners: new Set(), state: false, pending: false, target: false, tail: Promise.resolve() };
+    entries.set(uri, entry);
+  }
+  return entry;
+}
+function transition(connection: MCPServerConnection, uri: string, entry: Entry, target: boolean, options?: MCPRequestOptions): Promise<void> {
+  if (entry.pending && entry.target === target) return entry.tail;
+  const previous = entry.tail;
+  // Reserve the exact transition before any transport callback. New acquisition
+  // after a pending release waits for that unsubscribe before subscribing again.
+  entry.pending = true; entry.target = target;
+  const operation = previous.catch(() => {}).then(async () => {
+    if (entry.state === target) return;
+    try {
+      // A caller's abort releases only its own claim. It cannot cancel a wire
+      // transition also needed by another viewer or the manager's subscriptions.
+      const response = await connection.transport.request(target ? "resources/subscribe" : "resources/unsubscribe", { uri }, { signal: AbortSignal.timeout(30_000) });
+      if (!response || typeof response !== "object" || Array.isArray(response)) throw new Error("Malformed MCP subscription response.");
+      entry.state = target;
+    } catch (error) { entry.state = "unknown"; throw error; }
+  });
+  entry.tail = operation;
+  void operation.then(() => settled(), () => settled());
+  function settled() {
+    if (entry.tail !== operation) return;
+    entry.pending = false;
+    if (!entry.managed && !entry.owners.size && entry.state === false) connections.get(connection)?.delete(uri);
+  }
+  return operation;
+}
+/** The manager owns a single idempotent claim for each URI; its refresh and
+ * notifications switch cannot unsubscribe an independently retained viewer. */
+export function setManagedResourceSubscription(connection: MCPServerConnection, uri: string, enabled: boolean, options?: MCPRequestOptions): Promise<void> {
+  const entry = entryFor(connection, uri); entry.managed = enabled;
+  return transition(connection, uri, entry, enabled || entry.owners.size > 0, options);
+}
+/** Retain one original connection/URI. Readiness and cleanup preserve dispatched
+ * errors; the caller never receives a replacement connection or shared signal. */
+export function retainResourceSubscription(connection: MCPServerConnection, uri: string, options?: MCPRequestOptions): Promise<MCPResourceSubscription> {
+  options?.signal?.throwIfAborted();
+  const entry = entryFor(connection, uri), owner = Symbol("MCP resource viewer");
+  if (entry.owners.size >= 4096) throw new Error("MCP resource observer limit exceeded.");
+  entry.owners.add(owner);
+  let releasePromise: Promise<void> | undefined;
+  const release = () => {
+    if (releasePromise) return releasePromise;
+    options?.signal?.removeEventListener("abort", abort);
+    entry.owners.delete(owner);
+    return releasePromise = transition(connection, uri, entry, entry.managed || entry.owners.size > 0, options);
+  };
+  const abort = () => { void release().catch(() => {}); };
+  options?.signal?.addEventListener("abort", abort, { once: true });
+  const ready = transition(connection, uri, entry, true, options);
+  return ready.then(async () => {
+    if (options?.signal?.aborted) { await release(); options.signal.throwIfAborted(); }
+    return { release };
+  }, async error => {
+    try { await release(); } catch (cleanup) { throw new AggregateError([error, cleanup], "MCP resource subscription and cleanup failed."); }
+    throw error;
+  });
+}
