diff --git a/src/plan-mode/plan-review-document.ts b/src/plan-mode/plan-review-document.ts
new file mode 100755
index 0000000000000000000000000000000000000000..09da944d6756e72da02bc751a4a6175758c0d1ae
--- /dev/null
+++ b/src/plan-mode/plan-review-document.ts
@@ -0,0 +1,665 @@
+/**
+ * Pure document operations shared by native Plan review surfaces. Markdown
+ * section parsing remains owned by the existing plan-toc implementation.
+ */
+export {
+	joinPlanSections,
+	parsePlanSections,
+	sectionDeletionSpan,
+	stripInlineMarkdown,
+} from "../modes/components/plan-toc";
+export type { PlanSection } from "../modes/components/plan-toc";
+
+import { Markdown, Ellipsis, truncateToWidth, visibleWidth, type MarkdownTheme } from "@oh-my-pi/pi-tui";
+import { sanitizeText } from "@oh-my-pi/pi-utils";
+import { sanitizeStatusText } from "../modes/shared";
+import { getMarkdownTheme, getSymbolTheme, theme } from "../modes/theme/theme";
+import {
+	joinPlanSections,
+	parsePlanSections,
+	sectionDeletionSpan,
+	type PlanSection,
+} from "../modes/components/plan-toc";
+
+export interface PlanReviewLineContext {
+	text: string;
+	truncated: boolean;
+}
+
+export type PlanReviewAnnotationTarget =
+	| { kind: "section" }
+	| { kind: "line"; row: number; context: string; contextTruncated: boolean };
+
+export interface PlanReviewAnnotation {
+	note: string;
+	target: PlanReviewAnnotationTarget;
+}
+
+export interface PlanReviewDocumentSection extends PlanSection {
+	annotations: PlanReviewAnnotation[];
+}
+
+/** Serializable annotations retained by the plan-review owner between views. */
+export interface PlanReviewAnnotationState {
+	annotations: Array<{
+		section: {
+			index: number;
+			title: string;
+			/** Heading ancestry from the document root. */
+			path?: string[];
+			/** Hash of the section source, used to reject ambiguous moved headings. */
+			contentHash?: string;
+		};
+		target: { kind: "section" } | { kind: "line"; row: number; context: string; contextTruncated?: boolean };
+		note: string;
+	}>;
+}
+
+/** Heading ancestry for each section. Preamble sections have an empty path. */
+export function planReviewSectionPaths(sections: readonly PlanSection[]): string[][] {
+	const stack: Array<{ level: number; title: string }> = [];
+	return sections.map(section => {
+		if (section.level < 1) return [];
+		while (stack.length > 0 && stack[stack.length - 1]!.level >= section.level) stack.pop();
+		stack.push({ level: section.level, title: section.title });
+		return stack.map(entry => entry.title);
+	});
+}
+
+/** Exact native section fingerprint used by annotation realignment. */
+export function planReviewSectionContentHash(section: Pick<PlanSection, "raw">): string {
+	return `${section.raw.length}:${Bun.hash(section.raw).toString(16)}`;
+}
+
+export function clonePlanReviewAnnotation(annotation: PlanReviewAnnotation): PlanReviewAnnotation {
+	return {
+		note: annotation.note,
+		target:
+			annotation.target.kind === "section"
+				? { kind: "section" }
+				: {
+						kind: "line",
+						row: annotation.target.row,
+						context: annotation.target.context,
+						contextTruncated: annotation.target.contextTruncated,
+					},
+	};
+}
+
+/** Capture annotations with the path/hash anchors used by native Plan review. */
+export function capturePlanReviewAnnotationState(
+	sections: readonly PlanReviewDocumentSection[],
+): PlanReviewAnnotationState {
+	const annotations: PlanReviewAnnotationState["annotations"] = [];
+	const sectionPaths = planReviewSectionPaths(sections);
+	for (let sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
+		const section = sections[sectionIndex]!;
+		for (const annotation of section.annotations) {
+			annotations.push({
+				section: {
+					index: sectionIndex,
+					title: section.title,
+					path: sectionPaths[sectionIndex]!,
+					contentHash: planReviewSectionContentHash(section),
+				},
+				target:
+					annotation.target.kind === "section"
+						? { kind: "section" }
+						: {
+								kind: "line",
+								row: annotation.target.row,
+								context: annotation.target.context,
+								contextTruncated: annotation.target.contextTruncated,
+							},
+				note: annotation.note,
+			});
+		}
+	}
+	return { annotations };
+}
+
+function normalizeLineContext(context: PlanReviewLineContext): string {
+	const normalized = sanitizeText(context.text)
+		.replace(/[\u0000-\u001f\u007f-\u009f]/g, " ")
+		.replace(/ +/g, " ")
+		.trim()
+		.replace(/\s+/g, " ")
+		.trim();
+	return context.truncated && normalized.endsWith("…") ? normalized.slice(0, -1) : normalized;
+}
+
+/** Resolve a persisted rendered-line anchor to the nearest matching row. */
+export function resolvePlanReviewLineRow(
+	storedRow: number,
+	storedContext: PlanReviewLineContext,
+	contexts: readonly PlanReviewLineContext[],
+): number {
+	if (contexts.length === 0) return -1;
+	const targetRow = Math.max(0, Math.floor(storedRow));
+	const normalizedStoredContext = normalizeLineContext(storedContext);
+	if (!normalizedStoredContext) return -1;
+	let best = -1;
+	let bestDistance = Number.POSITIVE_INFINITY;
+	for (let row = 0; row < contexts.length; row++) {
+		const normalizedContext = normalizeLineContext(contexts[row]!);
+		if (
+			normalizedContext !== normalizedStoredContext &&
+			!normalizedContext.includes(normalizedStoredContext) &&
+			!normalizedStoredContext.includes(normalizedContext)
+		) continue;
+		const distance = Math.abs(row - targetRow);
+		if (distance < bestDistance) {
+			best = row;
+			bestDistance = distance;
+		}
+	}
+	return best;
+}
+
+/**
+ * Restore persisted annotations against current sections. The caller supplies
+ * the same rendered-line contexts used by its review surface; this helper owns
+ * the native path/hash and nearest-row reconciliation rules.
+ */
+export function restorePlanReviewAnnotations(
+	sections: readonly PlanSection[],
+	state: PlanReviewAnnotationState | undefined,
+	lineContexts: (sectionIndex: number) => readonly PlanReviewLineContext[],
+): PlanReviewAnnotation[][] {
+	const restored = sections.map(() => [] as PlanReviewAnnotation[]);
+	if (!state || !Array.isArray(state.annotations)) return restored;
+	const sectionPaths = planReviewSectionPaths(sections);
+	const contentHashes = sections.map(planReviewSectionContentHash);
+	for (const entry of state.annotations) {
+		if (!entry || typeof entry.note !== "string" || !entry.section || !entry.target || typeof entry.section.title !== "string") continue;
+		const note = entry.note.trim();
+		if (!note) continue;
+		const storedIndex = Number.isInteger(entry.section.index) ? entry.section.index : -1;
+		const storedPath = entry.section.path;
+		let matchingSections: number[];
+		if (Array.isArray(storedPath) && storedPath.every(segment => typeof segment === "string") && typeof entry.section.contentHash === "string") {
+			matchingSections = [];
+			for (let i = 0; i < sections.length; i++) {
+				const path = sectionPaths[i]!;
+				if (sections[i]!.title === entry.section.title && contentHashes[i] === entry.section.contentHash && path.length === storedPath.length
+					&& path.every((segment, pathIndex) => segment === storedPath[pathIndex])) matchingSections.push(i);
+			}
+		} else {
+			matchingSections = storedIndex >= 0 && storedIndex < sections.length && sections[storedIndex]!.title === entry.section.title ? [storedIndex] : [];
+		}
+		if (matchingSections.length === 0) continue;
+		const sectionIndex = matchingSections.reduce((best, candidate) =>
+			Math.abs(candidate - storedIndex) < Math.abs(best - storedIndex) ? candidate : best,
+		);
+		const section = sections[sectionIndex]!;
+		if (entry.target.kind === "section") {
+			if (section.level >= 1) restored[sectionIndex]!.push({ note, target: { kind: "section" } });
+			continue;
+		}
+		if (entry.target.kind !== "line" || !Number.isFinite(entry.target.row) || typeof entry.target.context !== "string") continue;
+		const contexts = lineContexts(sectionIndex);
+		const row = resolvePlanReviewLineRow(entry.target.row,
+			{ text: entry.target.context, truncated: entry.target.contextTruncated === true }, contexts);
+		if (row < 0) continue;
+		const context = contexts[row]!;
+		restored[sectionIndex]!.push({ note, target: { kind: "line", row, context: context.text, contextTruncated: context.truncated } });
+	}
+	return restored;
+}
+
+function markdownFenceFor(text: string): string {
+	let fence = "```";
+	while (text.includes(fence)) fence += "`";
+	return fence;
+}
+
+/** Exact native Markdown sent by the Refine branch for deletes/annotations. */
+export function formatPlanReviewFeedback(
+	sections: readonly PlanReviewDocumentSection[],
+	deleted: readonly string[],
+): string {
+	const annotated = sections.filter(section => section.annotations.length > 0);
+	if (annotated.length === 0 && deleted.length === 0) return "";
+	let feedback = "Refinement feedback on the plan:\n";
+	if (deleted.length > 0) {
+		feedback += "\nRemove these sections:\n";
+		for (const title of deleted) feedback += `- ${title}\n`;
+	}
+	for (const section of annotated) {
+		feedback += `\n## ${section.title || "Plan preamble"}\n`;
+		for (const annotation of section.annotations) {
+			if (annotation.target.kind === "line") feedback += `> Line: ${annotation.target.context}\n`;
+			const note = annotation.note;
+			feedback += note.includes("\n") ? `${markdownFenceFor(note)}md\n${note}\n${markdownFenceFor(note)}\n` : `- ${note}\n`;
+		}
+	}
+	return feedback;
+}
+
+/** Native-owned composition of structured document feedback and an optional
+ * free-form refinement. The structured block remains byte-exact when alone. */
+export function combinePlanReviewFeedback(documentFeedback: string, additionalFeedback: string): string {
+	if (!documentFeedback.trim()) return additionalFeedback;
+	if (!additionalFeedback.trim()) return documentFeedback;
+	return `${documentFeedback.trimEnd()}\n\n${additionalFeedback}`;
+}
+
+export const PLAN_REVIEW_RENDER_COLUMNS_MIN = 20;
+export const PLAN_REVIEW_RENDER_COLUMNS_MAX = 240;
+export const PLAN_REVIEW_SUMMARY_MAX_BYTES = 2 * 1024 * 1024;
+export const PLAN_REVIEW_SECTION_MAX_ROWS = 20_000;
+export const PLAN_REVIEW_SECTION_MAX_BYTES = 2 * 1024 * 1024;
+export const PLAN_REVIEW_MAX_ANNOTATIONS = 1_000;
+export const PLAN_REVIEW_ANNOTATION_MAX_BYTES = 500_000;
+const MAX_ANNOTATION_CONTEXT_WIDTH = 120;
+const encoder = new TextEncoder();
+
+export interface PlanReviewDocumentSectionSummary {
+	sectionId: string;
+	level: number;
+	title: string;
+	annotationCount: number;
+}
+
+export interface PlanReviewDocumentSummary {
+	documentRevision: string;
+	renderColumns: number;
+	canUndo: boolean;
+	feedback: string;
+	sections: PlanReviewDocumentSectionSummary[];
+	/** Section ids in exact native ToC order; omitted title/preamble sections remain in `sections`. */
+	toc: string[];
+}
+
+export interface PlanReviewDocumentRow {
+	rowId: string;
+	text: string;
+	truncated: boolean;
+	annotationIds: string[];
+}
+
+export interface PlanReviewDocumentAnnotationProjection {
+	annotationId: string;
+	note: string;
+	target: { kind: "section" } | { kind: "line"; rowId: string };
+}
+
+export interface PlanReviewDocumentSectionProjection extends PlanReviewDocumentSectionSummary {
+	documentRevision: string;
+	renderColumns: number;
+	rows: PlanReviewDocumentRow[];
+	annotations: PlanReviewDocumentAnnotationProjection[];
+}
+
+/** Native-only display rows plus the serializable section projection. */
+export interface PlanReviewNativeRenderedSection {
+	projection: PlanReviewDocumentSectionProjection;
+	displayRows: readonly string[];
+}
+
+export type PlanReviewDocumentAction =
+	| { kind: "delete-section"; expectedDocumentRevision: string; sectionId: string }
+	| {
+			kind: "annotate";
+			expectedDocumentRevision: string;
+			target:
+				| { kind: "section"; sectionId: string }
+				| { kind: "line"; sectionId: string; rowId: string };
+			note: string;
+	  }
+	| { kind: "undo"; expectedDocumentRevision: string };
+
+export interface PlanReviewDocumentMutationResult {
+	documentRevision: string;
+	content: string;
+	annotationState: PlanReviewAnnotationState;
+	feedback: string;
+	artifactChanged: boolean;
+	summary: PlanReviewDocumentSummary;
+}
+
+export interface PreparedPlanReviewDocumentMutation {
+	/** Candidate state. The caller adopts it only after any required artifact write succeeds. */
+	next: PlanReviewDocumentOwner;
+	result: PlanReviewDocumentMutationResult;
+}
+
+interface DocumentUndoEntry {
+	sections: PlanReviewDocumentSection[];
+	deleted: string[];
+}
+
+function renderedLineContext(line: string): PlanReviewLineContext {
+	const sanitized = sanitizeStatusText(line);
+	const truncated = visibleWidth(sanitized) > MAX_ANNOTATION_CONTEXT_WIDTH;
+	const text = truncateToWidth(sanitized, MAX_ANNOTATION_CONTEXT_WIDTH, Ellipsis.Unicode);
+	return { text: text || "(blank line)", truncated };
+}
+
+function plainMarkdownTheme(): MarkdownTheme {
+	const plain = (text: string) => text;
+	return {
+		heading: plain,
+		link: plain,
+		linkUrl: plain,
+		code: plain,
+		codeBlock: plain,
+		codeBlockBorder: plain,
+		quote: plain,
+		quoteBorder: plain,
+		hr: plain,
+		listBullet: plain,
+		bold: plain,
+		italic: plain,
+		underline: plain,
+		strikethrough: plain,
+		highlightCode: code => code.split("\n"),
+		symbols: getSymbolTheme(),
+	};
+}
+
+function activeMarkdownTheme(): MarkdownTheme {
+	// Worker-only document projection has no TUI and therefore may run before a
+	// global color theme exists. Styling never owns row identity; the native
+	// Markdown renderer and symbol layout remain the source of wrapping.
+	return typeof theme === "undefined" ? plainMarkdownTheme() : getMarkdownTheme();
+}
+
+function renderSection(section: PlanSection, columns: number): { displayRows: readonly string[]; contexts: PlanReviewLineContext[] } {
+	const displayRows = new Markdown(section.raw, 1, 0, activeMarkdownTheme()).render(columns);
+	return { displayRows, contexts: displayRows.map(renderedLineContext) };
+}
+
+function cloneSections(sections: readonly PlanReviewDocumentSection[]): PlanReviewDocumentSection[] {
+	return sections.map(section => ({
+		level: section.level,
+		title: section.title,
+		raw: section.raw,
+		annotations: section.annotations.map(clonePlanReviewAnnotation),
+	}));
+}
+
+function validColumns(value: number, nativeOverlay: boolean): number {
+	const minimum = nativeOverlay ? 1 : PLAN_REVIEW_RENDER_COLUMNS_MIN;
+	const maximum = nativeOverlay ? 4096 : PLAN_REVIEW_RENDER_COLUMNS_MAX;
+	if (!Number.isInteger(value) || value < minimum || value > maximum) {
+		throw new Error(`Plan review render columns must be an integer from ${minimum} to ${maximum}.`);
+	}
+	return value;
+}
+
+function opaqueDigest(parts: readonly (string | number)[]): string {
+	// Four independently salted native hashes keep the identifier opaque and at
+	// the same strict 64-hex width used by the owning review protocol. No client
+	// computes or interprets this value.
+	return ["a", "b", "c", "d"]
+		.map(salt => Bun.hash(`${salt}\0${parts.join("\0")}`).toString(16).padStart(16, "0"))
+		.join("");
+}
+
+/**
+ * Copy-on-write native owner for Plan review document structure. Artifact I/O
+ * remains with the caller: it adopts a prepared `next` owner only after the
+ * corresponding owned write succeeds.
+ */
+export class PlanReviewDocumentOwner {
+	#binding: string;
+	#nativeOverlay = false;
+	#counter = 0;
+	#documentRevision: string;
+	#sections: PlanReviewDocumentSection[];
+	#deleted: string[] = [];
+	#undo: DocumentUndoEntry[] = [];
+
+	constructor(content: string, options: { binding: string; annotationState?: PlanReviewAnnotationState }) {
+		if (!options.binding || options.binding.includes("\0")) throw new Error("A native Plan review binding is required.");
+		this.#binding = options.binding;
+		this.#sections = parsePlanSections(content).map(section => ({ ...section, annotations: [] }));
+		if (options.annotationState) {
+			const restored = restorePlanReviewAnnotations(this.#sections, options.annotationState, index =>
+				renderSection(this.#sections[index]!, MAX_ANNOTATION_CONTEXT_WIDTH).contexts,
+			);
+			for (let index = 0; index < this.#sections.length; index++) this.#sections[index]!.annotations = restored[index]!;
+		}
+		this.#documentRevision = this.#revision();
+	}
+
+	/** Native TUI construction keeps actual emergency and wide terminal widths;
+	 * desktop/public callers remain constrained to the exported projection range. */
+	static nativeOverlay(content: string, annotationState?: PlanReviewAnnotationState): PlanReviewDocumentOwner {
+		const owner = new PlanReviewDocumentOwner(content, { binding: `native-overlay:${Bun.hash(content).toString(16)}`, annotationState });
+		owner.#nativeOverlay = true;
+		return owner;
+	}
+
+	get documentRevision(): string {
+		return this.#documentRevision;
+	}
+
+	get content(): string {
+		return joinPlanSections(this.#sections);
+	}
+
+	get feedback(): string {
+		return formatPlanReviewFeedback(this.#sections, this.#deleted);
+	}
+
+	get annotationState(): PlanReviewAnnotationState {
+		return structuredClone(capturePlanReviewAnnotationState(this.#sections));
+	}
+
+	#revision(): string {
+		return opaqueDigest([
+			"document",
+			this.#binding,
+			this.#counter,
+			this.content,
+			JSON.stringify(capturePlanReviewAnnotationState(this.#sections)),
+			JSON.stringify(this.#deleted),
+		]);
+	}
+
+	#assertRevision(expected: string): void {
+		if (expected !== this.#documentRevision) throw new Error("The native Plan review document changed; refresh before continuing.");
+	}
+
+	#sectionId(index: number, columns: number): string {
+		const section = this.#sections[index]!;
+		return opaqueDigest(["section", this.#documentRevision, columns, index, section.level, section.title, planReviewSectionContentHash(section)]);
+	}
+
+	#rowId(sectionIndex: number, row: number, context: PlanReviewLineContext, columns: number): string {
+		return opaqueDigest(["row", this.#documentRevision, columns, sectionIndex, row, context.text, context.truncated ? 1 : 0]);
+	}
+
+	#annotationId(sectionIndex: number, annotationIndex: number, columns: number): string {
+		const annotation = this.#sections[sectionIndex]!.annotations[annotationIndex]!;
+		return opaqueDigest(["annotation", this.#documentRevision, columns, sectionIndex, annotationIndex, annotation.note,
+			annotation.target.kind === "section" ? "section" : `${annotation.target.row}\0${annotation.target.context}`]);
+	}
+
+	#tocIndices(): number[] {
+		const headings: number[] = [];
+		for (let index = 0; index < this.#sections.length; index++) if (this.#sections[index]!.level >= 1) headings.push(index);
+		let minLevel = Number.POSITIVE_INFINITY;
+		for (const index of headings) minLevel = Math.min(minLevel, this.#sections[index]!.level);
+		const topLevel = headings.filter(index => this.#sections[index]!.level === minLevel);
+		const titleIndex = topLevel.length === 1 && headings[0] === topLevel[0] ? topLevel[0] : -1;
+		return headings.filter(index => index !== titleIndex);
+	}
+
+	summary(expectedDocumentRevision: string, renderColumns: number): PlanReviewDocumentSummary {
+		this.#assertRevision(expectedDocumentRevision);
+		const columns = validColumns(renderColumns, this.#nativeOverlay);
+		const sections = this.#sections.map((section, index) => ({
+			sectionId: this.#sectionId(index, columns),
