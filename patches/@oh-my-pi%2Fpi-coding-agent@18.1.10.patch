+		catch (error) { this.abort(error); }
+	}
+	/** Only for a definitively lost parent/port, never a timeout standing in for a drain ACK. */
+	abort(error: unknown): void {
+		if (this.#settled) return;
+		this.#errors.push(error);
+		if (this.#settling) return;
+		this.#settling = true; this.#retire(); this.#settle();
+	}
+	#settle(): void {
+		// A valid drain/abort can arrive reentrantly from a close callback. Publish only
+		// after that synchronous callback (and any enclosing control post) has returned.
+		queueMicrotask(() => {
+			this.#settled = true;
+			if (this.#errors.length) this.#done.reject(new AggregateError(this.#errors, "Worker CDP cleanup failed"));
+			else this.#done.resolve();
+		});
+	}
+	dispose(): Promise<void> { this.close(); return this.#done.promise; }
+}
