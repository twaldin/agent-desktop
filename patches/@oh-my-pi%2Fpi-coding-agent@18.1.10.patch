+		worker.addEventListener("message", onMessage); removers.push(() => worker.removeEventListener("message", onMessage));
+		worker.addEventListener("error", onError); removers.push(() => worker.removeEventListener("error", onError));
+		worker.addEventListener("messageerror", onMessageError); removers.push(() => worker.removeEventListener("messageerror", onMessageError));
+	} catch (error) {
+		try { await attempt.abort(asError(error)); }
+		catch (cleanupError) { throw new AggregateError([error, cleanupError], "Worker listener setup and cleanup failed"); }
