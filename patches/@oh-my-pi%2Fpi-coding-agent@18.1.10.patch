+		} else {
+			const note = action.note.trim();
+			if (!note) throw new Error("A native Plan annotation note is required.");
+			if (encoder.encode(note).byteLength > PLAN_REVIEW_ANNOTATION_MAX_BYTES) throw new Error("The native Plan annotation is too large.");
+			const count = next.#sections.reduce((total, section) => total + section.annotations.length, 0);
+			if (count >= PLAN_REVIEW_MAX_ANNOTATIONS) throw new Error("The native Plan review has too many annotations.");
