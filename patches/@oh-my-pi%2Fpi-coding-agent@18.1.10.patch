--- /dev/null
+++ b/src/tools/browser/tab-worker-host.ts
@@ -0,0 +1,296 @@
+import { logger, workerHostEntry } from "@oh-my-pi/pi-utils";
+import type { Transferable, Transport, WorkerInbound, WorkerOutbound } from "./tab-protocol";
+import { ParentWorkerCdpChannel } from "./worker-cdp-channel";
+import type { OwnedCdpTransport, StartupCreationOutcome } from "./owned-cdp-transport";
+
+export interface WorkerHandle {
+	send(msg: WorkerInbound, transferList?: Transferable[]): void;
+	onMessage(handler: (msg: WorkerOutbound) => void): () => void;
+	onError(handler: (error: Error) => void): () => void;
+	/** Retire the facade while preserving its page; joins the original transport drain. */
+	terminate(): Promise<void>;
+	/** A hung/failed isolated worker needs a real termination, not a synthetic close receipt. */
+	abort(error: Error): Promise<void>;
+	assertActive(): void;
+	readonly startupCreations: readonly StartupCreationOutcome[];
+	finishStartup(): void;
+	readonly mode: "worker" | "inline";
+	readonly channelId: string;
+	readonly createdTargetId?: string;
+	/** Original port/worker failure, separate from errors retained by terminate(). */
+	readonly failure?: Error;
+	/** A void native terminate() result is not evidence of physical worker exit. */
+	readonly physicalExitConfirmed: boolean;
+}
+
+type Closed = Extract<WorkerOutbound, { type: "closed" }>;
+type Adapter = {
+	post(message: WorkerInbound, transferList?: Transferable[]): void;
+	retire(): void | Promise<void>;
+	force(error: Error): void | Promise<unknown>;
+	cleanup?(): void;
+};
+
+function asError(error: unknown): Error {
+	return error instanceof Error ? error : new Error(String(error));
+}
+
+/** One retained inbox per physical adapter, independent of supervisor subscriptions. */
+class WorkerAttempt implements WorkerHandle {
+	#messages = new Set<(message: WorkerOutbound) => void>();
+	#errors = new Set<(error: Error) => void>();
+	#cleanupErrors: unknown[] = [];
+	#parent: ParentWorkerCdpChannel;
+	#closed?: Closed;
+	#failure?: Error;
+	#createdTargetId?: string;
+	#initialized = false;
+	#retiring = false;
+	#normalClose = false;
+	#receipt = Promise.withResolvers<void>();
+	#termination?: Promise<void>;
+	#forced?: Promise<void>;
+	#physicalExitConfirmed = false;
+	#completed = false;
+
+	constructor(
+		readonly mode: "worker" | "inline",
+		readonly channelId: string,
+		readonly owned: OwnedCdpTransport,
+		readonly adapter: Adapter,
+	) {
+		// The owner is retained before start() can install replaying transport setters.
+		this.#parent = new ParentWorkerCdpChannel(channelId, owned, frame => {
+			try { adapter.post(frame); }
+			catch (error) { this.fail(asError(error)); throw error; }
+		});
+	}
+
+	assertActive(): void {
+		if (this.#retiring || this.#completed) throw new Error("Original worker attempt is retired");
+	}
+
+	get startupCreations(): readonly StartupCreationOutcome[] { return this.owned.startupCreations; }
+	finishStartup(): void { this.assertActive(); this.owned.finishStartup(); }
+
+	get createdTargetId(): string | undefined { return this.#createdTargetId; }
+	get failure(): Error | undefined { return this.#failure; }
+	get physicalExitConfirmed(): boolean { return this.#physicalExitConfirmed; }
+
+	send(message: WorkerInbound, transferList?: Transferable[]): void {
+		if (this.#retiring && message.type !== "worker-cdp") return;
+		if (message.type === "init") {
+			if (this.#initialized) throw new Error("Tab worker attempt is already initialized");
+			if (message.payload.cdpChannel !== this.channelId || message.payload.browserWSEndpoint !== undefined) {
+				throw new Error("Tab worker init must use its owned CDP channel");
+			}
+			this.#initialized = true;
+		}
+		if (message.type === "retire") { void this.terminate().catch(() => {}); return; }
+		if (message.type === "close") { this.#retiring = true; this.#normalClose = true; }
+		try {
+			this.adapter.post(message, transferList);
+			// FIFO delivery installs the child's channel before any parent startup frames.
+			if (message.type === "init") this.#parent.start();
+		} catch (error) {
+			this.fail(asError(error));
+			throw error;
+		}
+		if (message.type === "close") void this.terminate().catch(() => {});
+	}
+
+	onMessage(handler: (message: WorkerOutbound) => void): () => void {
+		if (!this.#completed) this.#messages.add(handler);
+		// Replay has the same error boundary as a live inbox callback.
+		try { if (this.#closed) handler(this.#closed); }
+		catch (error) { this.#messages.delete(handler); throw error; }
+		return () => { this.#messages.delete(handler); };
+	}
+
+	onError(handler: (error: Error) => void): () => void {
+		if (!this.#completed) this.#errors.add(handler);
+		try { if (this.#failure) handler(this.#failure); }
+		catch (error) { this.#errors.delete(handler); throw error; }
+		return () => { this.#errors.delete(handler); };
+	}
+
+	receive(message: WorkerOutbound): void {
+		if (this.#completed) return;
+		if (message.type === "worker-cdp") {
+			if (!this.#parent.receive(message)) this.fail(new Error("Unexpected worker CDP channel identity"));
+			return;
+		}
+		if (message.type === "page-created") this.#createdTargetId = message.targetId;
+		if (message.type === "closed") {
+			if (this.#closed) return;
+			this.#closed = message;
+			this.#retiring = true;
+			if (message.error) {
+				const error = new Error(message.error.message);
+				error.name = message.error.name;
+				error.stack = message.error.stack ?? error.stack;
+				this.#cleanupErrors.push(error);
+			}
+			this.#receipt.resolve();
+			void this.terminate().catch(() => {});
+		}
+		if (this.#retiring && message.type !== "closed" && message.type !== "page-created") return;
+		// Retain the inbox and creation receipt even after supervisor waiters unsubscribe.
+		for (const listener of [...this.#messages]) {
+			try { listener(message); } catch (error) { this.fail(asError(error)); }
+		}
+	}
+
+	/** Definitive worker/port failure; no synthetic successful child drain receipt. */
+	abort(error: Error): Promise<void> { this.fail(error); return this.terminate(); }
+
+	fail(error: Error): void {
+		if (this.#completed) return;
+		if (this.#failure) { this.#cleanupErrors.push(error); return; }
+		this.#failure = error;
+		this.#retiring = true;
+		this.#receipt.resolve();
+		void this.#force(error);
+		// The lost worker cannot request its own parent drain. Keep this real operation.
+		void this.#parent.dispose().catch(() => {});
+		void this.terminate().catch(() => {});
+		for (const listener of [...this.#errors]) {
+			try { listener(error); } catch (callbackError) { this.#cleanupErrors.push(callbackError); }
+		}
+	}
+
+	#force(error: Error): Promise<void> {
+		if (this.#forced) return this.#forced;
+		const forced = Promise.withResolvers<void>();
+		this.#forced = forced.promise;
+		void (async () => {
+			try {
+				const result = this.adapter.force(error);
+				await result;
+				if (this.mode === "worker" && result !== undefined) this.#physicalExitConfirmed = true;
+			} catch (cleanupError) { this.#cleanupErrors.push(cleanupError); }
+			finally { forced.resolve(); }
+		})();
+		return forced.promise;
+	}
+
+	terminate(): Promise<void> {
+		if (this.#termination) return this.#termination;
+		const done = Promise.withResolvers<void>();
+		this.#termination = done.promise;
+		void done.promise.catch(() => {});
+		this.#retiring = true;
+		void (async () => {
+			let retirement: void | Promise<void> = undefined;
+			if (!this.#failure && (this.mode === "inline" || (!this.#closed && !this.#normalClose))) {
+				try { retirement = this.adapter.retire(); }
+				catch (error) { this.fail(asError(error)); }
+			}
+			// Observe an inline core's actual retirement in addition to its closed receipt.
+			const coreDrain = Promise.resolve(retirement).catch(error => {
+				this.#cleanupErrors.push(error);
+				this.fail(asError(error));
+			});
+			// Graceful retirement keeps CDP available through dispatched init/run cleanup.
+			// Child close control starts parent.dispose(), whose ACK lets the child close.
+			await this.#receipt.promise;
+			// On definitive failure these drains are independent: join both even if one fails.
+			await Promise.all([
+				coreDrain,
+				this.#parent.dispose().catch(error => { this.#cleanupErrors.push(error); }),
+			]);
+			// coreDrain may itself have discovered the definitive failure while joining.
+			await this.#forced;
+			if (this.mode === "worker") await this.#force(new Error("Closed worker facade retired"));
+			this.#completed = true;
+			try { this.adapter.cleanup?.(); } catch (error) { this.#cleanupErrors.push(error); }
+			this.#messages.clear(); this.#errors.clear();
+			if (this.#cleanupErrors.length) {
+				done.reject(new AggregateError(this.#cleanupErrors, "Tab worker attempt cleanup failed"));
+			} else done.resolve();
+		})().catch(done.reject);
+		return done.promise;
+	}
+}
+
+export async function spawnTabWorker(owned: OwnedCdpTransport, channelId: string): Promise<WorkerHandle> {
+	let worker: Worker;
+	if (!channelId || channelId.length > 200) throw new Error("Invalid worker CDP channel identity");
+	try {
+		const hostEntry = workerHostEntry();
+		worker = hostEntry
+			? new Worker(hostEntry, { type: "module", argv: ["__omp_worker_tab"] })
+			: new Worker(new URL("./tab-worker-entry.ts", import.meta.url).href, { type: "module" });
+	} catch (error) {
+		// Construction never attached owned; this is the only same-transport fallback.
+		logger.warn("Bun Worker spawn failed; using inline tab worker (no sync-loop guard)", {
+			error: asError(error).message,
+		});
+		return spawnInlineWorker(owned, channelId);
+	}
+	const removers: Array<() => void> = [];
+	const attempt = new WorkerAttempt("worker", channelId, owned, {
+		post: (message, transferList) => worker.postMessage(message, { transfer: transferList ?? [] }),
+		retire: () => worker.postMessage({ type: "retire" } satisfies WorkerInbound),
+		force: () => worker.terminate(),
+		cleanup: () => {
+			const errors: unknown[] = [];
+			for (const remove of removers.splice(0)) { try { remove(); } catch (error) { errors.push(error); } }
+			if (errors.length) throw new AggregateError(errors, "Worker listener cleanup failed");
+		},
+	});
+	// Never tie physical inbox lifetime to a setup/ready/run listener's unsubscribe.
+	const onMessage = (event: MessageEvent) => {
+		try { attempt.receive(event.data as WorkerOutbound); }
+		catch (error) { attempt.fail(asError(error)); }
+	};
+	const onError = (event: ErrorEvent) => attempt.fail(event.error instanceof Error ? event.error : new Error(event.message || "Unknown tab worker error"));
+	const onMessageError = () => attempt.fail(new Error("Tab worker message error"));
+	try {
+		worker.addEventListener("message", onMessage); removers.push(() => worker.removeEventListener("message", onMessage));
+		worker.addEventListener("error", onError); removers.push(() => worker.removeEventListener("error", onError));
+		worker.addEventListener("messageerror", onMessageError); removers.push(() => worker.removeEventListener("messageerror", onMessageError));
+	} catch (error) {
+		try { await attempt.abort(asError(error)); }
+		catch (cleanupError) { throw new AggregateError([error, cleanupError], "Worker listener setup and cleanup failed"); }
+		throw error;
+	}
+	return attempt;
+}
+
+/** Inline preserves normal behavior, but cannot interrupt synchronous infinite loops. */
+export async function spawnInlineWorker(owned: OwnedCdpTransport, channelId: string): Promise<WorkerHandle> {
+	if (!channelId || channelId.length > 200) throw new Error("Invalid worker CDP channel identity");
+	const { WorkerCore } = await import("./tab-worker");
+	let inbox: ((message: WorkerInbound | WorkerOutbound) => void) | undefined;
+	let core: InstanceType<typeof WorkerCore>;
+	const attempt = new WorkerAttempt("inline", channelId, owned, {
+		post: message => queueMicrotask(() => {
+			try { inbox?.(message); } catch (error) { attempt.fail(asError(error)); }
+		}),
+		// Preserve inbox ordering: a preceding explicit close must keep its close-page intent.
+		retire: () => new Promise<void>((resolve, reject) => queueMicrotask(() => {
+			try { core.retire().then(resolve, reject); } catch (error) { reject(error); }
+		})),
+		force: error => core?.abort(error),
+	});
+	const transport: Transport = {
+		send: message => queueMicrotask(() => {
+			try { attempt.receive(message as WorkerOutbound); }
+			catch (error) { attempt.fail(asError(error)); }
+		}),
+		onMessage: handler => {
+			if (inbox) throw new Error("Inline tab worker already has an inbox");
+			inbox = handler;
+			return () => { if (inbox === handler) inbox = undefined; };
+		},
+		close: () => {},
+	};
+	try { core = new WorkerCore(transport, false); }
+	catch (error) {
+		try { await attempt.abort(asError(error)); }
+		catch (cleanupError) { throw new AggregateError([error, cleanupError], "Inline worker construction and cleanup failed"); }
+		throw error;
+	}
+	return attempt;
+}
