+						current();
+					} catch (error) { stop(error); }
+				},
+				receive(frame: WorkerCdpFrame) {
+					try {
+						current();
+						if (!sink) throw new Error("Reserved CDP channel receiver is not installed");
+						parent!.receive(structuredClone(frame));
+					} catch (error) { stop(error); }
+				},
+				dispose,
+			});
+			current();
+			return channel;
+		} catch (error) {
+			if (error !== cancelled) failures.push(error);
+			allocation.resolve();
+			await dispose();
+			throw error;
+		} finally { allocation.resolve(); }
+	});
+	void ready.catch(() => {});
+	return Object.freeze({ ready, dispose });
+}
