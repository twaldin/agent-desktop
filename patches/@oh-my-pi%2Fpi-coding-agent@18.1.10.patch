+++ b/src/tools/browser/worker-cdp-channel.ts
@@ -0,0 +1,249 @@
+import type { ConnectionTransport } from "puppeteer-core";
+
+/** One fresh, private channel per worker attempt. The existing worker dispatcher feeds receive(). */
+export type WorkerCdpFrame = {
+	readonly type: "worker-cdp";
+	readonly channel: string;
+} & (
+	| { readonly kind: "data"; readonly sequence: number; readonly data: string }
+	| { readonly kind: "ack"; readonly sequence: number }
+	| { readonly kind: "close"; readonly errors?: readonly string[] }
+	| { readonly kind: "drained"; readonly errors: readonly string[] }
+);
+
+export interface DrainedCdpTransport extends ConnectionTransport {
+	dispose(): Promise<void>;
+}
+
+const MAX_FRAMES = 256;
+const MAX_BYTES = 16 * 1024 * 1024;
+const encoder = new TextEncoder();
+function validErrors(value: unknown): value is string[] {
+	if (!Array.isArray(value) || value.length > MAX_FRAMES) return false;
+	for (const error of value) if (typeof error !== "string" || error.length > 4096) return false;
+	return true;
+}
+
+/** Ordered, bounded messages on a caller-owned worker port; never a socket or endpoint lookup. */
+class ChannelWire {
+	#next = 1;
+	#received = 0;
+	#pending = new Map<number, number>();
+	#bytes = 0;
+	closed = false;
+	constructor(
+		readonly channel: string,
+		readonly post: (frame: WorkerCdpFrame) => void,
+	) {
+		if (!channel || channel.length > 200) throw new Error("Invalid worker CDP channel identity");
+	}
+	control(frame: Omit<Extract<WorkerCdpFrame, { kind: "close" }>, "type" | "channel"> |
+		Omit<Extract<WorkerCdpFrame, { kind: "drained" }>, "type" | "channel">): void {
+		this.post({ type: "worker-cdp", channel: this.channel, ...frame });
+	}
+	retire(): void { this.closed = true; this.#pending.clear(); this.#bytes = 0; }
+	send(data: string): void {
+		if (this.closed) throw new Error("Worker CDP channel is closed");
+		const bytes = encoder.encode(data).byteLength;
+		if (this.#pending.size >= MAX_FRAMES || bytes > MAX_BYTES - this.#bytes || !Number.isSafeInteger(this.#next)) {
+			throw new Error("Worker CDP channel capacity exceeded");
+		}
+		const sequence = this.#next++;
+		this.#pending.set(sequence, bytes);
+		this.#bytes += bytes;
+		// Reserve before post: inline transports may deliver and acknowledge synchronously.
+		this.post({ type: "worker-cdp", channel: this.channel, kind: "data", sequence, data });
+	}
+	receive(value: unknown, data: (message: string) => void, close: () => void,
+		drained: (errors: readonly string[]) => void): boolean {
+		if (!value || typeof value !== "object") return false;
+		const frame = value as Record<string, unknown>;
+		if (frame.type !== "worker-cdp" || frame.channel !== this.channel) return false;
+		if (frame.kind === "close") {
+			if (frame.errors !== undefined && !validErrors(frame.errors)) throw new Error("Invalid worker CDP close request");
+			close(); return true;
+		}
+		if (frame.kind === "drained") {
+			if (!validErrors(frame.errors)) {
+				throw new Error("Invalid worker CDP drain receipt");
+			}
+			drained(frame.errors);
+			return true;
+		}
+		// Already queued data/credits cannot resurrect a retired attempt.
+		if (this.closed) return true;
+		if (frame.kind === "ack") {
+			if (typeof frame.sequence !== "number" || !this.#pending.has(frame.sequence)) {
+				throw new Error("Invalid worker CDP acknowledgement");
+			}
