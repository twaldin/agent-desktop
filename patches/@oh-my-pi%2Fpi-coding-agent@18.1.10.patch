+				return result;
+			} finally { pending.delete(done.promise); done.resolve(); }
+		},
+		dispose() {
+			if (!disposal) {
+				retired = true;
+				disposal = Promise.all([...pending]).then(() => {
+					if (failures.length) throw new AggregateError(failures, "Cmux evaluation channel drain failed");
+				});
+				void disposal.catch(() => {});
+			}
+			return disposal;
+		},
+	});
+}
