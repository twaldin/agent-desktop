+			});
+			const channel = Object.freeze({ descriptor: captured,
+				start(post: (frame: WorkerCdpFrame) => void) {
+					try {
+						current();
+						if (typeof post !== "function") throw new Error("Invalid reserved CDP channel receiver");
+						if (sink) { if (sink !== post) throw new Error("Reserved CDP channel already has a receiver"); return; }
+						sink = post; // Publish before setter replay or reentrant disposal.
