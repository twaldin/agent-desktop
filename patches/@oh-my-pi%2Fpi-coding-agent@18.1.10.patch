index 0000000000000000000000000000000000000000..b6b4128aeaf94688f2d81dbde0af2da08d9aeefa
--- /dev/null
+++ b/src/tools/browser/cmux/surface-observation.ts
@@ -0,0 +1,83 @@
+import type { CmuxSocketClient } from "./socket-client";
+
+export interface CmuxBrowserSurfaceSnapshot {
+	readonly surfaceId: string;
+	readonly workspaceId: string;
+	readonly windowId: string | null;
+}
+
+export interface CmuxSurfaceObservation {
+	/** Check the captured connection without reading, reconnecting, or rebinding. */
+	assertCurrent(): void;
+	/** Exact runtime UUID only. Errors, including owner not found, are not a closed receipt. */
+	inspect(surfaceId: string): Promise<CmuxBrowserSurfaceSnapshot>;
+}
+
+/**
+ * Capture the existing authenticated connection BEFORE creation/adoption and
+ * retain with the original native owner. Never connect or recapture to inspect
+ * history. Connection generation is not a cmux server-incarnation guarantee.
+ * This primitive returns positive snapshots and preserves correlated server
+ * errors; classifying absence requires the caller's separate backend authority.
+ */
+export function captureCmuxSurfaceObservation(client: CmuxSocketClient, timeoutMs: number): CmuxSurfaceObservation {
+	if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new Error("Invalid cmux observation timeout");
+	const generation = client.connectionGeneration;
+	const requireConnection = (): void => {
+		if (!Number.isSafeInteger(generation) || generation === undefined || generation <= 0 || client.connectionGeneration !== generation) {
+			throw new Error("Original cmux observation connection is unavailable");
+		}
+	};
+	requireConnection();
+	return Object.freeze({
+		assertCurrent: requireConnection,
+		async inspect(surfaceId: string): Promise<CmuxBrowserSurfaceSnapshot> {
+			const target = uuid(surfaceId);
+			if (!target) throw new Error("Invalid cmux observation surface UUID");
+			requireConnection();
+			let result: Record<string, unknown>;
+			try {
+				// An exact surface-only selector avoids caller/default workspace and
+				// lazy Dock routes. No browser.url.get: deferred browsers are present.
+				result = await client.request("surface.list", { surface_id: target }, {
+					connectionGeneration: generation, checkedReply: true, timeoutMs,
+				});
+			} catch (error) {
+				// Even a correlated negative reply cannot outlive this connection.
+				requireConnection();
+				throw error;
+			}
+			requireConnection();
+			const workspaceId = uuid(result.workspace_id);
+			const windowId = result.window_id === null ? null : uuid(result.window_id);
+			if (!workspaceId || windowId === undefined || !Array.isArray(result.surfaces)) {
+				throw new Error("Invalid cmux surface inventory");
+			}
+			const seen = new Set<string>();
+			let targetType: string | undefined;
+			for (const row of result.surfaces) {
+				if (!record(row)) throw new Error("Invalid cmux surface inventory");
+				const id = uuid(row.id);
+				if (!id || typeof row.type !== "string" || !row.type.length || seen.has(id)) {
+					throw new Error("Invalid cmux surface inventory");
+				}
+				seen.add(id);
+				if (id === target) targetType = row.type;
+			}
+			// Owner routing and ordered topology may disagree. Neither a missing
+			// list entry nor a different surface type proves original tab closure.
+			if (targetType === undefined) throw new Error("Requested cmux surface is missing from its owner inventory");
+			if (targetType !== "browser") throw new Error("Requested cmux surface is not a browser");
+			return Object.freeze({ surfaceId: target, workspaceId, windowId });
+		},
+	});
+}
+
+function uuid(value: unknown): string | undefined {
+	return typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)
+		? value.toLowerCase() : undefined;
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
