+			this.#fail(error);
+			return true;
+		}
+	}
+	send(message: string): void {
+		try { this.#wire.send(message); }
+		catch (error) { this.#fail(error); throw error; }
+	}
+	close(): void {
+		if (this.#wire.closed) return;
+		this.#retire();
