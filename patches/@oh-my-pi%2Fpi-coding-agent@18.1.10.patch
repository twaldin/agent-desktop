+			catch (error) { this.#errors.push(error); }
+			if (this.#errors.length) done.reject(new AggregateError(this.#errors, "Worker CDP parent cleanup failed"));
+			else done.resolve();
+		})();
+		return done.promise;
+	}
+}
+
+/** Worker side, passed directly to Puppeteer connect({transport}). No second inbox subscription. */
+export class WorkerCdpChannel implements DrainedCdpTransport {
+	#wire: ChannelWire;
+	#messages: string[] = [];
+	#bytes = 0;
+	#onmessage?: (message: string) => void;
+	#onclose?: () => void;
+	#notified = false;
+	#errors: unknown[] = [];
+	#done = Promise.withResolvers<void>();
+	#settled = false;
+	#settling = false;
+	constructor(channel: string, post: (frame: WorkerCdpFrame) => void, readonly onRetire?: () => void) {
+		this.#wire = new ChannelWire(channel, post);
+		// close() is the void Puppeteer interface; failures stay on retained dispose().
+		void this.#done.promise.catch(() => {});
+	}
+	get onmessage() { return this.#onmessage; }
+	set onmessage(handler: ((message: string) => void) | undefined) {
+		this.#onmessage = handler;
+		while (handler && !this.#wire.closed && this.#messages.length) {
+			const message = this.#messages.shift()!;
+			this.#bytes -= encoder.encode(message).byteLength;
+			try { handler(message); } catch (error) { this.#fail(error); }
+			handler = this.#onmessage;
+		}
+	}
+	get onclose() { return this.#onclose; }
+	set onclose(handler: (() => void) | undefined) { this.#onclose = handler; this.#notify(); }
+	#notify(): void {
+		if (!this.#wire.closed || this.#notified || !this.#onclose) return;
+		this.#notified = true;
+		try { this.#onclose(); } catch (error) { this.#errors.push(error); }
+	}
+	#retire(): void {
+		const first = !this.#wire.closed;
+		this.#wire.retire(); this.#messages = []; this.#bytes = 0;
+		if (first) { try { this.onRetire?.(); } catch (error) { this.#errors.push(error); } }
+		this.#notify();
+	}
+	#fail(error: unknown): void {
+		if (this.#settled) return;
+		this.#errors.push(error); this.close();
+	}
+	receive(frame: unknown): boolean {
+		try {
+			return this.#wire.receive(frame, message => {
+				if (this.#onmessage) this.#onmessage(message);
+				else {
+					const bytes = encoder.encode(message).byteLength;
+					if (this.#messages.length >= MAX_FRAMES || bytes > MAX_BYTES - this.#bytes) throw new Error("Worker CDP startup buffer exceeded");
+					this.#messages.push(message); this.#bytes += bytes;
+				}
+			}, () => this.#retire(), errors => {
+				if (this.#settled || this.#settling) return;
+				this.#settling = true;
