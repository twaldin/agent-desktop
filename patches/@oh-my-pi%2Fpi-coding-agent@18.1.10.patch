+import { ParentWorkerCdpChannel, type WorkerCdpFrame, type DrainedCdpTransport } from "./worker-cdp-channel";
+
+export type CdpEvaluationFrame = WorkerCdpFrame;
+export interface CdpEvaluationTransport extends DrainedCdpTransport {
