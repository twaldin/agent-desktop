+import type { ToolSession } from "../index";
+import { expandPath } from "../path-utils";
+import type { SessionSnapshot } from "./tab-protocol";
+
+/** Local run services, not a serializable session or native resource capability. */
+export interface BrowserRunContext {
+	readonly snapshot: Readonly<SessionSnapshot>;
+	/** Missing for internal navigation/viewport helpers that cannot call session tools. */
+	readonly callTool?: (name: string, args: unknown, signal?: AbortSignal, emitStatus?: Parameters<typeof callSessionTool>[2]["emitStatus"]) => ReturnType<typeof callSessionTool>;
+}
+
+/** Keep native tool lookup, permissions and nested preludes on the actual caller. */
+export function createBrowserRunContext(session: ToolSession, snapshot?: SessionSnapshot): BrowserRunContext {
+	if (!snapshot) {
+		const cwd = session.cwd;
+		const screenshotDir = session.settings.get("browser.screenshotDir") as string | undefined;
+		snapshot = {
+			cwd,
+			browserScreenshotDir: screenshotDir ? expandPath(screenshotDir) : undefined,
+			excludeWebP: webpExclusionForModel(session.getActiveModel?.()),
+		};
+	}
+	return {
+		snapshot,
+		callTool: (name, args, signal, emitStatus) => callSessionTool(name, args, {
+			session,
+			signal,
+			emitStatus,
+		}),
+	};
+}
