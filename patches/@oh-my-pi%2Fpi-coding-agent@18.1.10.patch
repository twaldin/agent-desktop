+}
+
+export interface CdpEvaluationDescriptor {
+	readonly version: 1;
+	readonly channel: string;
+	readonly targetId: string;
+	readonly activateForScreenshot: boolean;
+	readonly dialogs?: "accept" | "dismiss";
+}
+
+/** Original-browser transport authority; targetId selects retained bootstrap,
+ * not a one-page security sandbox or permission to replace the native owner. */
+export interface CdpEvaluationChannel {
+	readonly descriptor: Readonly<CdpEvaluationDescriptor>;
+	start(post: (frame: CdpEvaluationFrame) => void): void;
+	receive(frame: CdpEvaluationFrame): void;
+	dispose(): Promise<void>;
+}
+
+export interface CdpEvaluationOpening {
+	readonly ready: Promise<Readonly<CdpEvaluationChannel>>;
+	/** Bars publication immediately, joins allocation and detaches only its root. */
+	dispose(): Promise<void>;
+}
+
+/** The caller must publish this opening before native allocation can run. */
+export function createCdpEvaluationOpening(
+	descriptor: CdpEvaluationDescriptor,
+	source: { open(): Promise<CdpEvaluationTransport>; assertCurrent(): void },
+): Readonly<CdpEvaluationOpening> {
+	if (!descriptor || descriptor.version !== 1 || typeof descriptor.channel !== "string" || !descriptor.channel
+		|| descriptor.channel.length > 200 || typeof descriptor.targetId !== "string" || !descriptor.targetId
+		|| typeof descriptor.activateForScreenshot !== "boolean"
+		|| descriptor.dialogs !== undefined && descriptor.dialogs !== "accept" && descriptor.dialogs !== "dismiss") {
+		throw new Error("Invalid reserved CDP evaluation descriptor");
+	}
+	const captured = Object.freeze({ version: 1 as const, channel: descriptor.channel, targetId: descriptor.targetId,
+		activateForScreenshot: descriptor.activateForScreenshot, ...(descriptor.dialogs === undefined ? {} : { dialogs: descriptor.dialogs }) });
+	const open = source.open.bind(source), assertSource = source.assertCurrent.bind(source);
+	const allocation = Promise.withResolvers<void>();
+	const failures: unknown[] = [];
+	let retired = false, disposal: Promise<void> | undefined;
+	let transport: CdpEvaluationTransport | undefined, parent: ParentWorkerCdpChannel | undefined;
+	let sink: ((frame: WorkerCdpFrame) => void) | undefined;
+	const cancelled = new Error("Reserved CDP evaluation channel is retired");
+	const current = () => { if (retired) throw cancelled; assertSource(); };
+	const dispose = (): Promise<void> => {
+		if (disposal) return disposal;
+		retired = true;
+		const done = Promise.withResolvers<void>();
+		disposal = done.promise;
+		void (async () => {
+			await allocation.promise;
+			try { if (parent) await parent.dispose(); else await transport?.dispose(); }
+			catch (error) { failures.push(error); }
+			if (failures.length) throw new AggregateError(failures, "Reserved CDP channel opening or drain failed");
+		})().then(done.resolve, done.reject);
+		return disposal;
+	};
+	const stop = (error: unknown) => {
+		if (error !== cancelled) failures.push(error);
+		void dispose().catch(() => {});
+		throw error;
+	};
+	const ready = Promise.resolve().then(async () => {
+		try {
+			current();
+			transport = await open();
+			current();
+			// This is retained bootstrap: no page is created during allocation.
+			// Subsequent native Browser APIs keep their existing browser-wide scope.
+			transport.finishStartup();
+			current();
+			parent = new ParentWorkerCdpChannel(captured.channel, transport, frame => {
+				if (frame.kind === "data" || frame.kind === "ack") { if (retired) return; current(); }
+				else retired = true;
+				// Close/drained remain deliverable after retirement. Before start no
+				// destination owns this channel, so only original-side drain is owed.
