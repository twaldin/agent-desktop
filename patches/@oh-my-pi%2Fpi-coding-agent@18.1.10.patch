+	if (!value || typeof value !== "object" || Array.isArray(value)
+		|| ![Object.prototype, null].includes(Object.getPrototypeOf(value))) throw new ToolError("Invalid cmux evaluation record");
+	const copy: Record<string, unknown> = Object.create(null);
+	for (const key of Reflect.ownKeys(value)) {
+		const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+		if (typeof key !== "string" || !descriptor.enumerable || !("value" in descriptor)) throw new ToolError("Invalid cmux evaluation field");
+		copy[key] = descriptor.value;
+	}
+	return copy;
