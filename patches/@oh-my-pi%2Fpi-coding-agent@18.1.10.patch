@@ -0,0 +1,91 @@
+import type { Browser } from "puppeteer-core";
+import type { CdpBrowser } from "puppeteer-core/internal/cdp/Browser.js";
+import type { Connection } from "puppeteer-core/internal/cdp/Connection.js";
+
+export interface BrowserTargetObservation {
+	/** Check the captured connection without reading, reconnecting, or rebinding. */
+	assertCurrent(): void;
+	/** One read of the captured backend connection; failures are never absence. */
+	inspect(targetId: string): Promise<"present" | "absent">;
+}
+
+/**
+ * Capture BEFORE creating/adopting the target, then retain with its native owner.
+ * This reads Puppeteer 25.3.0's original root connection, never a target session.
+ * It owns no browser/connection lease and must not be recaptured to recover a
+ * historical target after disconnect. Cmux uses its separate socket protocol.
+ */
+export async function captureBrowserTargetObservation(
+	browser: Browser,
+	backend: "headless" | "spawned" | "connected" | "relay",
+	timeoutMs: number,
+): Promise<BrowserTargetObservation> {
+	if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) throw new Error("Invalid browser observation timeout");
+	if (!["headless", "spawned", "connected", "relay"].includes(backend)) throw new Error("Unsupported browser observation backend");
+	// The deep type and guarded getter are intentionally pinned. The public
+	// Browser API only offers target attachment, which fails for relay-browser.
+	const source = browser as unknown as Pick<CdpBrowser, "_connection">;
+	const connection: Connection | undefined = source._connection;
+	const requireConnection = (): Connection => {
+		if (!connection || typeof connection.send !== "function" || connection._closed !== false ||
+			source._connection !== connection || browser.connected !== true) {
+			throw new Error("Original browser observation connection is unavailable");
+		}
+		return connection;
+	};
+	// Only these three read commands pass through this private protocol seam.
+	// OMP commands are not part of devtools-protocol's generated command union.
+	const read = async (method: "Target.getTargets" | "OMP.getObservationContext" | "OMP.inspectTab", params: Record<string, unknown>): Promise<unknown> => {
+		const current = requireConnection();
+		const send = current.send as (method: string, params: Record<string, unknown>, options: { timeout: number }) => Promise<unknown>;
+		const result = await send.call(current, method, params, { timeout: timeoutMs });
+		requireConnection();
+		return result;
+	};
+	let relayConnection: string | undefined;
+	if (backend === "relay") {
+		const context = await read("OMP.getObservationContext", {});
+		if (!record(context) || context.version !== 1 || typeof context.connectionId !== "string" || context.connectionId.length === 0) {
+			throw new Error("Relay observation context is unavailable");
+		}
+		relayConnection = context.connectionId;
+	} else {
+		requireConnection();
+	}
+	return Object.freeze({
+		assertCurrent: () => { requireConnection(); },
+		async inspect(targetId: string): Promise<"present" | "absent"> {
+			if (typeof targetId !== "string" || targetId.length === 0) throw new Error("Invalid browser observation target");
+			if (relayConnection !== undefined) {
+				const match = /^(?:PAGE|TAB)(0|[1-9][0-9]*)$/.exec(targetId);
+				if (!match || !Number.isSafeInteger(Number(match[1]))) throw new Error("Invalid relay observation target");
+				const result = await read("OMP.inspectTab", { connectionId: relayConnection, targetId });
+				if (!record(result) || result.connectionId !== relayConnection || result.targetId !== targetId || typeof result.present !== "boolean") {
+					throw new Error("Invalid relay observation response");
+				}
+				return result.present ? "present" : "absent";
+			}
+			// An explicit include-all filter avoids inheriting discovery exclusions.
+			const result = await read("Target.getTargets", { filter: [{}] });
+			if (!record(result) || !Array.isArray(result.targetInfos)) throw new Error("Invalid browser target inventory");
+			const seen = new Set<string>();
+			let present = false;
+			for (const info of result.targetInfos) {
+				if (!record(info) || typeof info.targetId !== "string" || info.targetId.length === 0 ||
+					typeof info.type !== "string" || info.type.length === 0 || seen.has(info.targetId)) {
+					throw new Error("Invalid browser target inventory");
+				}
+				seen.add(info.targetId);
+				if (info.targetId === targetId) {
+					if (info.type !== "page") throw new Error("Browser observation target is not a page");
+					present = true;
+				}
+			}
+			return present ? "present" : "absent";
+		},
+	});
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
