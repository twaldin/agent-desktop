+		);
+		for (let index = 0; index < next.#sections.length; index++) next.#sections[index]!.annotations = restored[index]!;
+		next.#deleted = [];
+		next.#undo = [];
+		next.#advance();
+		return { next, result: next.#result(columns, next.content !== this.content) };
+	}
+}
