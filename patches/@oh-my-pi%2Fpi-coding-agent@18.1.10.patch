+		if (!this.closed) this.post({ type: "worker-cdp", channel: this.channel, kind: "ack", sequence });
+		return true;
+	}
+}
+
+function errorMessages(errors: readonly unknown[]): string[] {
+	return errors.flatMap(error => error instanceof AggregateError ? errorMessages(error.errors) :
+		[error instanceof Error ? error.message : String(error)]).slice(0, MAX_FRAMES).map(message => message.slice(0, 4096));
