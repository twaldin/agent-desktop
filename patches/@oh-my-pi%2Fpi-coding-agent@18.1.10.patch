+		} catch (error) { this.#fail(error); return true; }
+	}
+	#fail(error: unknown): void {
+		this.#errors.push(error);
+		void this.dispose().catch(() => {});
+	}
+	dispose(): Promise<void> {
+		if (this.#disposal) return this.#disposal;
+		const done = Promise.withResolvers<void>();
+		this.#disposal = done.promise;
+		this.#wire.retire();
+		try { this.#wire.control({ kind: "close" }); } catch (error) { this.#errors.push(error); }
+		try { this.transport.onmessage = undefined; } catch (error) { this.#errors.push(error); }
+		try { this.transport.onclose = undefined; } catch (error) { this.#errors.push(error); }
+		void (async () => {
+			try { await this.transport.dispose(); } catch (error) { this.#errors.push(error); }
