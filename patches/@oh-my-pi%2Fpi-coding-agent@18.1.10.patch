+/**
+ * Enumerates current authoritative tab metadata for one creator session.
+ * Empty/unknown owners never act as a wildcard. Results are cloned immutable
+ * values so callers cannot retain or mutate native tab state.
+ */
+export function listTabsForOwner(ownerSessionId: string): readonly OwnerTabMetadata[] {
+	if (!ownerSessionId) return Object.freeze([]) as readonly OwnerTabMetadata[];
+	const snapshot = [...tabs.values()]
+		.filter(tab => tab.ownerSessionId === ownerSessionId)
+		.map(tab => Object.freeze({
+			name: tab.name,
+			ownerSessionId,
+			targetId: tab.targetId,
+			backend: tab.backend,
+			kindTag: tab.kindTag,
+			state: tab.state,
+			info: Object.freeze({
+				url: tab.info.url,
+				title: tab.info.title,
+				viewport: Object.freeze({ ...tab.info.viewport }),
+				targetId: tab.info.targetId,
+			}),
+		}));
+	return Object.freeze(snapshot);
+}
+
+/**
+ * Captures the current viewport of one exact owner-bound Puppeteer tab.
+ * It never activates, navigates, resizes, or closes the tab.
+ */
+export async function captureTabViewportForOwner(
+	ownerSessionId: string,
+	target: OwnerTabViewportTarget,
+): Promise<Readonly<OwnerTabViewportCapture>> {
+	if (!ownerSessionId || !target.name || !target.targetId) throw new ToolError("Browser viewport capture requires an exact owner, name, and target id");
+	const key = `${ownerSessionId}\0${target.name}\0${target.targetId}`;
+	if (viewportCaptures.has(key)) throw new ToolError("This browser viewport is already being captured");
+	if (viewportCaptures.size >= 8) throw new ToolError("Browser viewport capture concurrency limit reached");
+	const tab = tabs.get(target.name);
+	if (!tab || tab.ownerSessionId !== ownerSessionId || tab.targetId !== target.targetId || tab.state !== "alive") {
+		throw new ToolError("The selected owner-bound browser tab is no longer available");
+	}
+	if (tab.backend === "cmux") throw new ToolError("Viewport capture is not supported for cmux browser tabs");
+	const pending = (async () => {
+		let exactTarget: Target | undefined;
+		for (const candidate of tab.browser.browser.targets()) {
+			if ((await targetIdForTarget(candidate)) === target.targetId) { exactTarget = candidate; break; }
+		}
+		if (!exactTarget) throw new ToolError("The selected browser target is no longer attached");
+		const page = await exactTarget.page();
+		if (!page) throw new ToolError("The selected browser target is not a page");
+		const data = Buffer.from(await page.screenshot({ type: "jpeg", quality: 80, fullPage: false, captureBeyondViewport: false }));
+		if (data.byteLength === 0 || data.byteLength > 8 * 1024 * 1024) throw new ToolError("Browser viewport capture exceeded the 8 MiB transport bound");
+		const url = page.url(), title = await page.title();
+		const current = tabs.get(target.name);
+		if (current !== tab || current.ownerSessionId !== ownerSessionId || current.targetId !== target.targetId || current.state !== "alive") {
+			throw new ToolError("The selected owner-bound browser tab changed during capture");
+		}
+		if ((await targetIdForTarget(page.target())) !== target.targetId) throw new ToolError("The selected browser target changed during capture");
+		return Object.freeze({ name: tab.name, ownerSessionId, targetId: tab.targetId, data, url, title });
+	})();
+	viewportCaptures.set(key, pending);
+	void pending.then(() => viewportCaptures.delete(key), () => viewportCaptures.delete(key));
+	return await withTimeout(pending, 10_000, "Timed out after 10000ms capturing the browser viewport");
