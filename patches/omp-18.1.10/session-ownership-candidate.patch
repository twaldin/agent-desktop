+      regular(lockPath);
+      return new SessionFileLease(canonical, lock, parentInfo, revision);
+    } catch (error) { lock.release(); throw error; }
+  }
+  get released(): boolean { return this.#released; }
+  #fail(message: string): never { this.#poison ??= new Error(message); throw this.#poison; }
+  assertPath(file: string = this.file): void {
+    if (this.#released) throw new Error("Session ownership has been released");
+    if (this.#poison) throw this.#poison;
+    if (path.resolve(file) !== this.file) this.#fail("Writer path is outside its admitted session lease");
+    const parent = path.dirname(this.file);
+    if (fs.realpathSync(parent) !== parent || !equalIdentity(fs.statSync(parent), this.#parent)) this.#fail("Session parent identity changed after admission");
+    const visible = regular(this.file);
+    if (this.#revision ? !visible || !equalRevision(visible, this.#revision) : visible !== undefined) this.#fail("Session file identity or revision changed after admission");
+  }
+  assertDescriptor(fd: number): void {
+    this.assertPath();
+    const actual = fs.fstatSync(fd);
+    if (!this.#revision || !equalRevision(actual, this.#revision) || actual.nlink !== 1) this.#fail("Session writer descriptor is not the admitted file");
+  }
+  /** A write through an already validated descriptor changed only this inode. */
+  written(fd: number): void {
+    const actual = fs.fstatSync(fd), visible = regular(this.file);
+    if (!this.#revision || !equalIdentity(actual, this.#revision) || !visible || !equalRevision(actual, visible) || actual.nlink !== 1) this.#fail("Session path changed during a descriptor write");
+    this.#revision = actual;
+  }
+  /** Accept only the known staged inode after its atomic publication. */
+  replaced(expected: fs.Stats): void {
+    const visible = regular(this.file);
+    if (!visible || !equalIdentity(visible, expected) || visible.nlink !== 1) this.#fail("Session replacement did not publish its staged inode");
+    this.#revision = visible;
+  }
+  /** Both per-file leases are already held. Keep publication and inode rebinding
+   * in one synchronous operation so hot-path appends cannot see half a move. */
+  renameTo(destination: SessionFileLease): void {
+    this.assertPath(); destination.assertPath();
+    if (!this.#revision || destination.#revision) throw new Error("Session relocation needs an existing source and absent destination");
+    const source = this.#revision;
+    fs.renameSync(this.file, destination.file);
+    destination.replaced(source);
+    this.#revision = undefined;
+    this.assertPath();
+  }
+  read(expected?: SessionOwnershipExpectation): string {
+    this.assertPath();
+    if (!this.#revision) {
+      if (expected) throw new Error("Inspected original session no longer exists");
+      return "";
+    }
+    const fd = fs.openSync(this.file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
+    try {
+      this.assertDescriptor(fd);
+      const contents = fs.readFileSync(fd, "utf8");
+      this.assertDescriptor(fd);
+      if (expected) {
+        if (expected.canonicalFile !== this.file || createHash("sha256").update(contents).digest("hex") !== expected.sha256) throw new Error("Inspected original session revision changed");
+        const header = contents.trim().split("\n").map(line => JSON.parse(line)).find(entry => entry.type === "session");
+        if (!header || header.id !== expected.nativeId || header.cwd !== expected.recordedCwd) throw new Error("Inspected native session ID or cwd changed");
+        if (!fs.statSync(fs.realpathSync(header.cwd)).isDirectory()) throw new Error("Inspected native working directory is unavailable");
+      }
+      return contents;
+    } finally { fs.closeSync(fd); }
+  }
+  release(): void { if (!this.#released) { this.#released = true; this.#lock.release(); } }
+}
