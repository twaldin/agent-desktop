+ * happen. A refusal before that open is therefore proven to have had no
+ * effect; anything that fails afterwards is an unknown outcome and says so.
+ */
+export async function openAdmittedOriginal(options: {
+	ownershipDirectory: string;
+	binding: NativeOriginalBinding;
+	source: NativeOriginalSource;
+	commandId: string;
