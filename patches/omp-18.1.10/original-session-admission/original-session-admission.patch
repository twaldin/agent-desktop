+ */
+export declare class OriginalSessionOutcomeUnknownError extends Error {
+    readonly code: "OUTCOME_UNKNOWN";
+    readonly reason: string;
+    constructor(reason: string, message: string, options?: {
+        cause?: unknown;
+    });
+}
