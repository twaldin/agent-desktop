+
+/**
+ * Re-observe an enrolled original without taking ownership.
+ *
+ * Deliberately performs no directory migration, no header rewrite and no
+ * writable open: callers use this to refresh a reviewed source before a later
+ * admission, and an observation that mutated the original would destroy the
+ * very identity it reports.
+ */
+export async function observeEnrolledOriginal(
+	ownershipDirectory: string,
+	binding: NativeOriginalBinding,
+): Promise<NativeOriginalSource> {
+	assertBindingShape(binding);
+	const ownershipRoot = path.resolve(ownershipDirectory);
+	const record = loadEnrollment(ownershipRoot, binding.nativeId, binding.originalFile);
+	assertMarkerAgrees(record, ownershipRoot);
+	if (record.enrollmentId !== binding.enrollmentId) {
+		throw notSubmitted(
+			"enrollment-mismatch",
+			`The binding claims enrollment ${binding.enrollmentId}; the registry holds ${record.enrollmentId}.`,
+		);
+	}
+
+	const observed = observeSourceBytes(binding.originalFile).source;
+	if (observed.nativeId !== binding.nativeId) {
+		throw notSubmitted(
+			"native-id-mismatch",
+			`${binding.originalFile} now carries native session ${observed.nativeId}, not the enrolled ${binding.nativeId}.`,
+		);
+	}
+	return observed;
+}
+
+/**
+ * Create a brand-new original that participates in the cooperating regime.
+ *
+ * Ownership and the enrollment record are established BEFORE the first header
+ * is published, which is what makes the resulting provenance meaningful: the
+ * regime is a property of how the transcript was born, never a marker that can
+ * be stamped onto an unknown stock transcript later.
+ */
+export async function createCooperativeOriginal(options: {
+	ownershipDirectory: string;
+	cwd: string;
+	sessionDirectory: string;
+}): Promise<{ manager: SessionManager; binding: NativeOriginalBinding }> {
+	const ownershipDirectory = path.resolve(options.ownershipDirectory);
+	const cwd = path.resolve(options.cwd);
+	let canonicalCwd: string;
+	try {
+		canonicalCwd = fs.realpathSync(cwd);
+	} catch (error) {
+		throw notSubmitted("cwd-unusable", `The requested working directory is not resolvable: ${cwd}`, error);
+	}
+	prepareOwnershipDirectory(ownershipDirectory);
+
+	const manager = SessionManager.create(cwd, path.resolve(options.sessionDirectory), new FileSessionStorage());
+	const originalFile = manager.getSessionFile();
+	if (!originalFile) {
+		throw notSubmitted("not-persisted", "A cooperating original requires a persisted session file.");
+	}
+	const resolvedOriginal = path.resolve(originalFile);
+	if (fs.existsSync(resolvedOriginal)) {
+		throw notSubmitted(
+			"original-exists",
+			`Refusing to enroll ${resolvedOriginal}: it already exists, and an existing transcript can never be enrolled retrospectively.`,
+		);
+	}
+	const parentIdentity = readNodeIdentity(path.dirname(resolvedOriginal));
+	if (!parentIdentity) {
+		throw notSubmitted("parent-missing", `The session directory does not exist: ${path.dirname(resolvedOriginal)}`);
+	}
+
+	const nativeId = manager.getSessionId();
+	const registryId = registryKey("id", nativeId);
+	const record: EnrollmentRecord = {
+		protocol: ORIGINAL_SESSION_OWNERSHIP_PROTOCOL,
+		enrollmentId: Bun.randomUUIDv7(),
+		registryId,
+		nativeId,
+		originalFile: resolvedOriginal,
+		recordedCwd: cwd,
+		canonicalCwd,
+		lockPath: path.join(ownershipDirectory, LEASES_DIRECTORY, `${registryId}.lock`),
+		parentIdentity,
+		createdAt: new Date().toISOString(),
+	};
