+
+/**
+ * A refusal proven to precede every effect must also leave no ownership
+ * behind. When the release itself fails the refusal is no longer provably
+ * clean, so the outcome is reported as unknown instead.
+ */
+function releaseAfterPreEffectRefusal(lease: OriginalWriterLease, cause: unknown): never {
+	try {
+		lease.release();
+	} catch (error) {
+		throw outcomeUnknown(
+			"lease-release-failed",
+			`The original was refused before any effect, but ownership could not be relinquished: ${toError(error).message}`,
+			cause,
+		);
+	}
+	throw cause;
+}
+
+function hasCode(error: unknown, code: string): boolean {
+	return (error as NodeJS.ErrnoException | undefined)?.code === code;
+}
