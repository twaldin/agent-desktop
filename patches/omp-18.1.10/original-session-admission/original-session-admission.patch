+	let manager: SessionManager;
+	try {
+		manager = await SessionManager.open(originalFile, path.dirname(originalFile), new FileSessionStorage(), {
+			suppressBreadcrumb: true,
+			originalOwnership: lease,
+		});
+	} catch (error) {
