+	const openedFile = manager.getSessionFile();
+	if (
+		manager.getSessionId() !== binding.nativeId ||
+		!openedFile ||
+		path.resolve(openedFile) !== originalFile ||
+		path.resolve(manager.getRecordedCwd() ?? "") !== binding.recordedCwd
+	) {
+		throw outcomeUnknown(
+			"post-open-identity-drift",
+			`The admitted manager for ${originalFile} does not report the enrolled identity; ownership is retained.`,
+		);
+	}
+	return manager;
+}
+
+/** Every reviewed fact, re-proven while the writer lock is held. */
+function revalidateUnderOwnership(
+	binding: NativeOriginalBinding,
+	source: NativeOriginalSource,
+	originalFile: string,
+	record: EnrollmentRecord,
+	ownershipDirectory: string,
+): ObservedOriginal {
+	assertMarkerAgrees(record, ownershipDirectory);
+	const observed = observeSourceBytes(originalFile);
+	const drift = fileIdentityDifference(source.fileIdentity, observed.identity);
+	if (drift) {
+		throw notSubmitted(
+			"identity-mismatch",
+			`The reviewed original changed before admission: ${drift} no longer matches the reviewed value.`,
+		);
+	}
+	if (observed.source.contentSha256 !== source.contentSha256) {
+		throw notSubmitted("digest-mismatch", `The reviewed digest for ${originalFile} no longer matches its content.`);
+	}
+	if (observed.source.nativeId !== binding.nativeId) {
+		throw notSubmitted(
+			"native-id-mismatch",
+			`${originalFile} carries native session ${observed.source.nativeId}, not the enrolled ${binding.nativeId}.`,
+		);
+	}
+	if (observed.source.recordedCwd !== binding.recordedCwd || observed.source.canonicalCwd !== binding.canonicalCwd) {
+		throw notSubmitted(
+			"cwd-mismatch",
+			`${originalFile} records working directory ${observed.source.recordedCwd}, not the enrolled ${binding.recordedCwd}.`,
+		);
+	}
+	return observed;
