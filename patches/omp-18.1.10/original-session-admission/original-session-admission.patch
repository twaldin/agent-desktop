+	// Real OS ownership first: everything below is validated while no other
+	// cooperating writer can be mutating the transcript.
+	const lease = OriginalWriterLease.acquire({
+		enrollmentId: record.enrollmentId,
+		registryId: record.registryId,
+		nativeId: record.nativeId,
+		originalFile,
+		lockPath: record.lockPath,
+		expectedParentIdentity: record.parentIdentity,
+	});
