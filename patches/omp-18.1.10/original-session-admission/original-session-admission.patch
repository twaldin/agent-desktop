+	// Real ownership precedes the registry write, which precedes the header:
+	// no window exists in which the transcript exists without an owner.
+	const lease = OriginalWriterLease.acquire({
+		enrollmentId: record.enrollmentId,
+		registryId,
+		nativeId,
+		originalFile: resolvedOriginal,
+		lockPath: record.lockPath,
+		expectedParentIdentity: parentIdentity,
+	});
+
+	const marker: OriginalEnrollmentMarker = {
+		protocol: ORIGINAL_SESSION_OWNERSHIP_PROTOCOL,
+		registryId,
+		enrollmentId: record.enrollmentId,
+		nativeId,
+		ownershipDirectory,
+	};
+	const written = { record: false, index: false, marker: false };
+	try {
+		try {
+			fs.writeFileSync(recordPath(ownershipDirectory, registryId), `${JSON.stringify(record, null, 2)}\n`, {
+				flag: "wx",
+				mode: 0o600,
+			});
+			written.record = true;
+		} catch (error) {
+			if (!hasCode(error, "EEXIST")) throw error;
+			throw notSubmitted(
+				"duplicate-native-id",
+				`Native session ${nativeId} is already enrolled; refusing to mint a conflicting duplicate.`,
+			);
+		}
+		try {
+			fs.writeFileSync(fileIndexPath(ownershipDirectory, resolvedOriginal), `${JSON.stringify({ registryId })}\n`, {
+				flag: "wx",
+				mode: 0o600,
+			});
+			written.index = true;
+		} catch (error) {
+			if (!hasCode(error, "EEXIST")) throw error;
+			throw notSubmitted(
+				"file-conflict",
+				`${resolvedOriginal} is already claimed by another enrollment; refusing to mint a conflicting alias.`,
+			);
+		}
+		try {
+			// Durable, path-local recognition: from here on any patched open of
+			// this transcript that arrives without the matching admitted lease
+			// refuses, in this process or any other.
+			writeOriginalEnrollmentMarker(resolvedOriginal, marker);
+			written.marker = true;
+		} catch (error) {
+			if (!hasCode(error, "EEXIST")) throw error;
+			throw notSubmitted(
+				"file-conflict",
+				`${resolvedOriginal} already carries a cooperating enrollment marker; refusing to mint a second one.`,
+			);
+		}
+	} catch (error) {
+		throw unwindEnrollment(ownershipDirectory, registryId, resolvedOriginal, lease, written, error);
+	}
