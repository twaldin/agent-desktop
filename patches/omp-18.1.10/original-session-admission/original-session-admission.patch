+	const originalFile = path.resolve(source.originalFile);
+	if (originalFile !== binding.originalFile) {
+		throw notSubmitted(
+			"binding-source-mismatch",
+			`The reviewed source describes ${originalFile}; the binding owns ${binding.originalFile}.`,
+		);
+	}
+	if (source.nativeId !== binding.nativeId) {
+		throw notSubmitted(
+			"binding-source-mismatch",
+			`The reviewed source carries native session ${source.nativeId}; the binding claims ${binding.nativeId}.`,
+		);
+	}
+	if (path.resolve(source.recordedCwd) !== binding.recordedCwd || source.canonicalCwd !== binding.canonicalCwd) {
+		throw notSubmitted(
+			"binding-source-mismatch",
+			`The reviewed working directory ${source.recordedCwd} does not match the enrolled ${binding.recordedCwd}.`,
+		);
+	}
+
+	const ownershipDirectory = path.resolve(options.ownershipDirectory);
+	const record = loadEnrollment(ownershipDirectory, binding.nativeId, originalFile);
+	if (record.enrollmentId !== binding.enrollmentId || record.registryId !== binding.registryId) {
+		throw notSubmitted(
+			"enrollment-mismatch",
+			`The binding claims enrollment ${binding.enrollmentId}; the registry holds ${record.enrollmentId}.`,
+		);
+	}
+	if (record.recordedCwd !== binding.recordedCwd || record.canonicalCwd !== binding.canonicalCwd) {
+		throw notSubmitted(
+			"cwd-mismatch",
+			`Enrollment ${record.enrollmentId} records ${record.recordedCwd}, not the requested ${binding.recordedCwd}.`,
+		);
+	}
