+		// failure can leave migration or repair work half-applied. Ownership is
+		// retained so nothing else claims the original on this evidence.
+		if (error instanceof OriginalSessionNotSubmittedError) throw error;
+		if (error instanceof OriginalSessionOutcomeUnknownError) throw error;
+		throw outcomeUnknown(
+			"open-failed",
+			`Opening the admitted original ${originalFile} failed after ownership was taken: ${toError(error).message}`,
+			error,
+		);
+	}
