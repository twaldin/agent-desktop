@@ -0,0 +1,825 @@
+import { createHash } from "node:crypto";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { isEnoent, toError } from "@oh-my-pi/pi-utils";
+import {
+	assertSafeOriginalTarget,
+	fileIdentityDifference,
+	type NativeFileIdentity,
+	type NativeNodeIdentity,
+	notSubmitted,
+	ORIGINAL_SESSION_OWNERSHIP_PROTOCOL,
+	type OriginalEnrollmentMarker,
+	originalEnrollmentMarkerPath,
+	OriginalSessionNotSubmittedError,
+	OriginalSessionOutcomeUnknownError,
+	OriginalWriterLease,
+	outcomeUnknown,
+	readNodeIdentity,
+	readOriginalEnrollmentMarker,
+	sameNodeIdentity,
+	writeOriginalEnrollmentMarker,
+} from "./original-session-lease";
+import { SessionManager } from "./session-manager";
+import { FileSessionStorage } from "./session-storage";
+
+export {
+	type NativeFileIdentity,
+	ORIGINAL_SESSION_OWNERSHIP_PROTOCOL,
+	OriginalSessionNotSubmittedError,
+	OriginalSessionOutcomeUnknownError,
+};
+
+/**
+ * Durable proof that one native original transcript was created by a known
+ * cooperating writer under this protocol generation.
+ *
+ * A binding is minted exactly once, by {@link createCooperativeOriginal},
+ * before that original's first header reaches disk. It is never derived from
+ * an observation of an already-existing transcript: an unknown stock original
+ * has no binding and can never acquire one retrospectively.
+ */
+export interface NativeOriginalBinding {
+	protocol: typeof ORIGINAL_SESSION_OWNERSHIP_PROTOCOL;
+	enrollmentId: string;
+	registryId: string;
+	originalFile: string;
+	nativeId: string;
+	recordedCwd: string;
+	canonicalCwd: string;
+}
+
+/**
+ * The reviewed state of an original transcript at the moment a caller decided
+ * to admit it. Structurally the native half of the host's reviewed session
+ * source, which additionally carries the UI candidate id and revision.
+ *
+ * Every field is revalidated under real ownership before a writable open.
+ */
+export interface NativeOriginalSource {
+	originalFile: string;
+	nativeId: string;
+	recordedCwd: string;
+	canonicalCwd: string;
+	contentSha256: string;
+	fileIdentity: NativeFileIdentity;
+}
+
+export type OriginalParticipation =
+	| { ok: true; binding: NativeOriginalBinding }
+	| { ok: false; reason: string; message: string };
+
+interface EnrollmentRecord {
+	protocol: number;
+	enrollmentId: string;
+	registryId: string;
+	nativeId: string;
+	originalFile: string;
+	recordedCwd: string;
+	canonicalCwd: string;
+	lockPath: string;
+	parentIdentity: NativeNodeIdentity;
+	createdAt: string;
+}
+
+interface ObservedOriginal {
+	source: NativeOriginalSource;
+	identity: NativeFileIdentity;
+}
+
+const RECORDS_DIRECTORY = "records";
+const FILES_DIRECTORY = "files";
+const LEASES_DIRECTORY = "leases";
+const PROTOCOL_MARKER = "protocol.json";
+/** Re-reads allowed while a concurrent writer keeps moving the transcript. */
+const OBSERVATION_ATTEMPTS = 4;
+/** The header is the first entry after the fixed-width title slot. */
+const HEADER_SEARCH_LINES = 8;
+
+/**
+ * Namespaced so a registry key can never collide with a key minted by another
+ * protocol generation, and so the two index spaces (by native id, by canonical
+ * path) can never produce the same file name.
+ */
+function registryKey(space: "id" | "file", value: string): string {
+	return createHash("sha256")
+		.update(`omp-original-session-ownership\u0000${ORIGINAL_SESSION_OWNERSHIP_PROTOCOL}\u0000${space}\u0000${value}`)
+		.digest("hex");
+}
+
+function recordPath(ownershipDirectory: string, registryId: string): string {
+	return path.join(ownershipDirectory, RECORDS_DIRECTORY, `${registryId}.json`);
+}
+
+function fileIndexPath(ownershipDirectory: string, originalFile: string): string {
+	return path.join(ownershipDirectory, FILES_DIRECTORY, `${registryKey("file", originalFile)}.json`);
+}
+
+function readJsonFile(target: string): unknown {
+	let raw: string;
+	try {
+		raw = fs.readFileSync(target, "utf-8");
+	} catch (error) {
+		if (isEnoent(error)) return undefined;
+		throw notSubmitted("enrollment-unreadable", `Could not read ${target}: ${toError(error).message}`, error);
+	}
+	try {
+		return JSON.parse(raw) as unknown;
+	} catch (error) {
+		throw notSubmitted("enrollment-unreadable", `The enrollment record at ${target} is not valid JSON.`, error);
+	}
+}
+
+/**
+ * Load the enrollment for `nativeId` and prove it still describes exactly
+ * `originalFile` under this protocol generation.
+ *
+ * The reverse (path to enrollment) index is checked too: a second enrollment
+ * claiming the same canonical transcript, or a duplicate native id pointing at
+ * a different transcript, is a conflict rather than a match.
+ */
+function loadEnrollment(ownershipDirectory: string, nativeId: string, originalFile: string): EnrollmentRecord {
+	const registryId = registryKey("id", nativeId);
+	const record = readJsonFile(recordPath(ownershipDirectory, registryId)) as EnrollmentRecord | undefined;
+	if (!record) {
+		throw notSubmitted(
+			"not-enrolled",
+			`No cooperating enrollment exists for native session ${nativeId}; it was not created by a known cooperating writer.`,
+		);
+	}
+	if (record.protocol !== ORIGINAL_SESSION_OWNERSHIP_PROTOCOL) {
+		throw notSubmitted(
+			"protocol-mismatch",
+			`Enrollment ${record.enrollmentId} uses ownership protocol ${record.protocol}, not ${ORIGINAL_SESSION_OWNERSHIP_PROTOCOL}.`,
+		);
+	}
+	if (record.registryId !== registryId || record.nativeId !== nativeId) {
+		throw notSubmitted(
+			"enrollment-mismatch",
+			`The enrollment record for native session ${nativeId} is self-inconsistent.`,
+		);
+	}
+	if (record.originalFile !== originalFile) {
+		throw notSubmitted(
+			"duplicate-native-id",
+			`Native session ${nativeId} is enrolled for ${record.originalFile}, not ${originalFile}.`,
+		);
+	}
+
+	const index = readJsonFile(fileIndexPath(ownershipDirectory, originalFile)) as { registryId?: string } | undefined;
+	if (!index) {
+		throw notSubmitted("not-enrolled", `No cooperating enrollment claims the transcript ${originalFile}.`);
+	}
+	if (index.registryId !== registryId) {
+		throw notSubmitted(
+			"file-conflict",
+			`The transcript ${originalFile} is claimed by a different enrollment than native session ${nativeId}.`,
+		);
+	}
+	return record;
+}
+
+/**
+ * Prove the registry and the transcript's own durable marker still agree.
+ *
+ * The marker is what every other process recognises the enrolled source by, so
+ * a record without its marker (or with a foreign one) is a broken enrollment
+ * rather than an admissible one, and fails closed.
+ */
+function assertMarkerAgrees(record: EnrollmentRecord, ownershipDirectory: string): void {
+	const marker = readOriginalEnrollmentMarker(record.originalFile);
+	if (marker === undefined) {
+		throw notSubmitted(
+			"enrollment-marker-missing",
+			`${record.originalFile} is registered as enrollment ${record.enrollmentId} but carries no marker at ${originalEnrollmentMarkerPath(record.originalFile)}.`,
+		);
+	}
+	if (marker === "unreadable") {
+		throw notSubmitted(
+			"enrollment-marker-unreadable",
+			`The enrollment marker beside ${record.originalFile} could not be understood.`,
+		);
+	}
+	if (
+		marker.protocol !== ORIGINAL_SESSION_OWNERSHIP_PROTOCOL ||
+		marker.registryId !== record.registryId ||
+		marker.enrollmentId !== record.enrollmentId ||
+		marker.nativeId !== record.nativeId ||
+		path.resolve(marker.ownershipDirectory) !== ownershipDirectory
+	) {
+		throw notSubmitted(
+			"enrollment-marker-mismatch",
+			`The enrollment marker beside ${record.originalFile} describes a different enrollment than the registry.`,
+		);
+	}
+}
+
+/** Locate the session header without loading, migrating, or rewriting anything. */
+function readHeaderFromContent(content: string, originalFile: string): { id: string; cwd: string | undefined } {
+	let start = 0;
+	for (let line = 0; line < HEADER_SEARCH_LINES && start < content.length; line++) {
+		const end = content.indexOf("\n", start);
+		const text = content.slice(start, end === -1 ? content.length : end);
+		start = end === -1 ? content.length : end + 1;
+		if (!text) continue;
+		let parsed: { type?: string; id?: unknown; cwd?: unknown };
+		try {
+			parsed = JSON.parse(text) as { type?: string; id?: unknown; cwd?: unknown };
+		} catch {
+			continue;
+		}
+		if (parsed?.type !== "session") continue;
+		if (typeof parsed.id !== "string" || parsed.id.length === 0) break;
+		return { id: parsed.id, cwd: typeof parsed.cwd === "string" ? parsed.cwd : undefined };
+	}
+	throw notSubmitted("invalid-header", `The original session ${originalFile} has no usable session header.`);
+}
+
+/**
+ * Read the transcript and prove the bytes did not move under the reader.
+ *
+ * Without the identity sandwich a concurrent writer could append between the
+ * stat and the read, and the returned digest would describe a file state that
+ * never existed as a whole.
+ */
+function observeSourceBytes(originalFile: string): ObservedOriginal {
+	for (let attempt = 0; attempt < OBSERVATION_ATTEMPTS; attempt++) {
+		let stats: fs.Stats;
+		try {
+			stats = fs.lstatSync(originalFile);
+		} catch (error) {
+			if (isEnoent(error)) {
+				throw notSubmitted("original-missing", `The original session file does not exist: ${originalFile}`);
+			}
+			throw notSubmitted("original-unreadable", `Could not stat ${originalFile}: ${toError(error).message}`, error);
+		}
+		assertSafeOriginalTarget(originalFile, stats);
+		const before: NativeFileIdentity = {
+			dev: stats.dev,
+			ino: stats.ino,
+			size: stats.size,
+			mtimeMs: stats.mtimeMs,
+			ctimeMs: stats.ctimeMs,
+			birthtimeMs: stats.birthtimeMs,
+		};
+
+		let content: string;
+		try {
+			content = fs.readFileSync(originalFile, "utf-8");
+		} catch (error) {
+			if (isEnoent(error)) {
+				throw notSubmitted("original-missing", `The original session file disappeared while reading: ${originalFile}`);
+			}
+			throw notSubmitted("original-unreadable", `Could not read ${originalFile}: ${toError(error).message}`, error);
+		}
+
+		let after: fs.Stats;
+		try {
+			after = fs.lstatSync(originalFile);
+		} catch {
+			continue;
+		}
+		if (after.dev !== before.dev || after.ino !== before.ino || after.size !== before.size) continue;
+		if (after.mtimeMs !== before.mtimeMs || after.ctimeMs !== before.ctimeMs) continue;
+
+		const header = readHeaderFromContent(content, originalFile);
+		if (!header.cwd) {
+			throw notSubmitted("cwd-missing", `The original session ${originalFile} records no working directory.`);
+		}
+		const recordedCwd = path.resolve(header.cwd);
+		let canonicalCwd: string;
+		try {
+			canonicalCwd = fs.realpathSync(recordedCwd);
+		} catch (error) {
+			throw notSubmitted(
+				"cwd-unusable",
+				`The working directory recorded by ${originalFile} is not resolvable: ${recordedCwd}`,
+				error,
+			);
+		}
+		return {
+			identity: before,
+			source: {
+				originalFile,
+				nativeId: header.id,
+				recordedCwd,
+				canonicalCwd,
+				contentSha256: createHash("sha256").update(content, "utf-8").digest("hex"),
+				fileIdentity: before,
+			},
+		};
+	}
+	throw notSubmitted(
+		"unstable-original",
+		`The original session ${originalFile} kept changing while it was being observed; no stable state could be recorded.`,
+	);
+}
+
+function assertSourceShape(source: NativeOriginalSource): void {
+	if (typeof source?.originalFile !== "string" || !path.isAbsolute(source.originalFile)) {
+		throw notSubmitted("invalid-source", "A reviewed native source must carry an absolute original file path.");
+	}
+	if (typeof source.nativeId !== "string" || source.nativeId.length === 0) {
+		throw notSubmitted("invalid-source", "A reviewed native source must carry a native session id.");
+	}
+	if (typeof source.contentSha256 !== "string" || source.contentSha256.length !== 64) {
+		throw notSubmitted("invalid-source", "A reviewed native source must carry a SHA-256 content digest.");
+	}
+	if (!source.fileIdentity || typeof source.fileIdentity.ino !== "number") {
+		throw notSubmitted("invalid-source", "A reviewed native source must carry a complete file identity.");
+	}
+}
+
+function assertBindingShape(binding: NativeOriginalBinding): void {
+	if (binding?.protocol !== ORIGINAL_SESSION_OWNERSHIP_PROTOCOL) {
+		throw notSubmitted(
+			"protocol-mismatch",
+			`This build speaks ownership protocol ${ORIGINAL_SESSION_OWNERSHIP_PROTOCOL}; the binding claims ${binding?.protocol}.`,
+		);
+	}
+	for (const field of [
+		"enrollmentId",
+		"registryId",
+		"originalFile",
+		"nativeId",
+		"recordedCwd",
+		"canonicalCwd",
+	] as const) {
+		if (typeof binding[field] !== "string" || binding[field].length === 0) {
+			throw notSubmitted("invalid-binding", `The native binding is missing ${field}.`);
+		}
+	}
+	if (!path.isAbsolute(binding.originalFile) || path.resolve(binding.originalFile) !== binding.originalFile) {
+		throw notSubmitted("invalid-binding", `The native binding path is not canonical: ${binding.originalFile}`);
+	}
+}
+
+function bindingFor(record: EnrollmentRecord): NativeOriginalBinding {
+	return {
+		protocol: ORIGINAL_SESSION_OWNERSHIP_PROTOCOL,
+		enrollmentId: record.enrollmentId,
+		registryId: record.registryId,
+		originalFile: record.originalFile,
+		nativeId: record.nativeId,
+		recordedCwd: record.recordedCwd,
+		canonicalCwd: record.canonicalCwd,
+	};
+}
+
+/**
+ * Decide whether a reviewed original participates in the cooperating regime.
+ *
+ * Strictly readonly: no directory is created, no lock is attempted, and no
+ * native session is opened. A refusal is a value rather than a throw, because
+ * a non-participating original is an ordinary answer, not a failure.
+ */
+export async function inspectOriginalParticipation(
+	ownershipDirectory: string,
+	source: NativeOriginalSource,
+): Promise<OriginalParticipation> {
+	try {
+		assertSourceShape(source);
+		const resolvedDirectory = path.resolve(ownershipDirectory);
+		const originalFile = path.resolve(source.originalFile);
+		const record = loadEnrollment(resolvedDirectory, source.nativeId, originalFile);
+		assertMarkerAgrees(record, resolvedDirectory);
+
+		if (record.recordedCwd !== path.resolve(source.recordedCwd) || record.canonicalCwd !== source.canonicalCwd) {
+			throw notSubmitted(
+				"cwd-mismatch",
+				`Enrollment ${record.enrollmentId} records ${record.recordedCwd}, not the reviewed ${source.recordedCwd}.`,
+			);
+		}
+		if (!sameNodeIdentity(readNodeIdentity(path.dirname(originalFile)), record.parentIdentity)) {
+			throw notSubmitted("parent-retargeted", `The directory holding ${originalFile} was replaced since enrollment.`);
+		}
+
+		const observed = observeSourceBytes(originalFile);
+		const drift = fileIdentityDifference(source.fileIdentity, observed.identity);
+		if (drift) {
+			throw notSubmitted(
+				"identity-mismatch",
+				`The reviewed original changed on disk: ${drift} no longer matches the reviewed value.`,
+			);
+		}
+		if (observed.source.contentSha256 !== source.contentSha256) {
+			throw notSubmitted("digest-mismatch", `The reviewed digest for ${originalFile} no longer matches its content.`);
+		}
+		if (observed.source.nativeId !== record.nativeId) {
+			throw notSubmitted(
+				"native-id-mismatch",
+				`${originalFile} now carries native session ${observed.source.nativeId}, not the enrolled ${record.nativeId}.`,
+			);
+		}
