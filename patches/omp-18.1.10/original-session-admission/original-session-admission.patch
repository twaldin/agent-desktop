+import * as fs from "node:fs";
+import * as path from "node:path";
+import { FileLock } from "@oh-my-pi/pi-natives";
+import { isEnoent, logger, toError } from "@oh-my-pi/pi-utils";
+
+/**
+ * Wire generation of the cooperating original-session ownership regime.
+ *
+ * Bumping this invalidates every existing enrollment record: a record written
+ * by another generation is never adopted, so a future protocol can change the
+ * record shape without silently inheriting stale bindings.
+ */
+export const ORIGINAL_SESSION_OWNERSHIP_PROTOCOL = 1;
+
+/** Exact filesystem identity of an original transcript, as reviewed before admission. */
+export interface NativeFileIdentity {
+	dev: number;
+	ino: number;
+	size: number;
+	mtimeMs: number;
+	ctimeMs: number;
+	birthtimeMs: number;
+}
+
+/** Inode-level identity of a directory or lock sidecar bound by an enrollment. */
+export interface NativeNodeIdentity {
+	dev: number;
+	ino: number;
+}
+
+/**
+ * The requested original was NOT submitted to a writer, and that refusal is
+ * proven to have happened before any effect on the original file, its
+ * enrollment record, or its lock sidecar.
+ *
+ * A cleanup failure is never reported through this class — see
+ * {@link OriginalSessionOutcomeUnknownError}.
+ */
+export class OriginalSessionNotSubmittedError extends Error {
+	readonly code = "ORIGINAL_SESSION_NOT_SUBMITTED" as const;
+	readonly reason: string;
+
+	constructor(reason: string, message: string, options?: { cause?: unknown }) {
+		super(message, options);
+		this.name = "OriginalSessionNotSubmittedError";
+		this.reason = reason;
+	}
+}
+
+/**
+ * Effects on the original may have begun and could not be proven undone.
+ * Callers must treat the original as possibly mutated and possibly still
+ * owned; they must not retry as though nothing happened.
+ */
+export class OriginalSessionOutcomeUnknownError extends Error {
+	readonly code = "OUTCOME_UNKNOWN" as const;
+	readonly reason: string;
+
+	constructor(reason: string, message: string, options?: { cause?: unknown }) {
+		super(message, options);
+		this.name = "OriginalSessionOutcomeUnknownError";
+		this.reason = reason;
+	}
+}
+
+export function notSubmitted(reason: string, message: string, cause?: unknown): OriginalSessionNotSubmittedError {
+	return new OriginalSessionNotSubmittedError(reason, message, cause === undefined ? undefined : { cause });
+}
+
+export function outcomeUnknown(reason: string, message: string, cause?: unknown): OriginalSessionOutcomeUnknownError {
+	return new OriginalSessionOutcomeUnknownError(reason, message, cause === undefined ? undefined : { cause });
+}
+
+export function readNodeIdentity(target: string): NativeNodeIdentity | undefined {
+	const stats = lstatOrUndefined(target);
+	return stats ? { dev: stats.dev, ino: stats.ino } : undefined;
+}
+
+export function sameNodeIdentity(a: NativeNodeIdentity | undefined, b: NativeNodeIdentity | undefined): boolean {
+	return !!a && !!b && a.dev === b.dev && a.ino === b.ino;
+}
+
+/** Field-by-field comparison; every reviewed field must still hold. */
+export function fileIdentityDifference(
+	expected: NativeFileIdentity,
+	actual: NativeFileIdentity,
+): keyof NativeFileIdentity | undefined {
+	for (const field of ["dev", "ino", "size", "mtimeMs", "ctimeMs", "birthtimeMs"] as const) {
+		if (expected[field] !== actual[field]) return field;
+	}
+	return undefined;
+}
+
+function lstatOrUndefined(target: string): fs.Stats | undefined {
+	try {
+		return fs.lstatSync(target);
+	} catch (error) {
+		if (isEnoent(error)) return undefined;
+		throw error;
+	}
+}
+
+/**
+ * A transcript is only a safe ownership target when the path itself is the
+ * single name of a regular file: a symlink hands the write to an unknown
+ * target and a hard link lets a second name alias the owned bytes without
+ * ever contending for the sidecar.
+ */
+export function assertSafeOriginalTarget(file: string, stats: fs.Stats): void {
+	if (stats.isSymbolicLink()) {
+		throw notSubmitted("unsafe-alias", `The original session path is a symbolic link: ${file}`);
+	}
+	if (!stats.isFile()) {
+		throw notSubmitted("unsafe-alias", `The original session path is not a regular file: ${file}`);
+	}
+	if (stats.nlink !== 1) {
+		throw notSubmitted("unsafe-alias", `The original session file has ${stats.nlink} hard links: ${file}`);
+	}
+}
+
+/** Immutable view of an installed lease, safe to hand to observers. */
+export interface OriginalOwnershipView {
+	protocol: typeof ORIGINAL_SESSION_OWNERSHIP_PROTOCOL;
+	enrollmentId: string;
+	registryId: string;
+	nativeId: string;
+	originalFile: string;
+	lockPath: string;
+	commandId: string | undefined;
+	held: boolean;
+}
+
+/**
+ * Every lease this process currently holds, keyed by canonical original file.
+ *
+ * The OS lock is what excludes a competing cooperating process; this map is
+ * what excludes a second manager inside THIS process — including an internal
+ * unmanaged `SessionManager.open()` that never went through admission.
+ */
+const activeLeases = new Map<string, OriginalWriterLease>();
+
+/**
+ * Refuse a write/open against a canonical original owned by a different lease
+ * in this process. Free for every unenrolled manager: with no lease anywhere
+ * in the process the map is empty and this is a single size check.
+ */
+export function assertNoForeignOriginalWriter(target: string, mine: OriginalWriterLease | undefined): void {
+	if (activeLeases.size === 0) return;
+	const holder = activeLeases.get(path.resolve(target));
+	if (!holder || holder === mine || !holder.held) return;
+	throw notSubmitted(
+		"active-writer",
+		`The original session ${holder.originalFile} is owned by an active cooperating writer in this process (enrollment ${holder.enrollmentId}).`,
+	);
+}
+
+/** Durable, path-local proof that a transcript belongs to an enrollment. */
+export interface OriginalEnrollmentMarker {
+	protocol: number;
+	registryId: string;
+	enrollmentId: string;
+	nativeId: string;
+	ownershipDirectory: string;
+}
+
+/**
+ * Where the enrollment marker for `originalFile` lives: a dotfile beside the
+ * transcript, outside the `*.jsonl` namespace the session listing scans.
+ */
+export function originalEnrollmentMarkerPath(originalFile: string): string {
+	const resolved = path.resolve(originalFile);
+	return path.join(path.dirname(resolved), `.${path.basename(resolved)}.original-enrollment.json`);
+}
+
+export function readOriginalEnrollmentMarker(originalFile: string): OriginalEnrollmentMarker | undefined | "unreadable" {
+	const markerPath = originalEnrollmentMarkerPath(originalFile);
+	let raw: string;
+	try {
+		raw = fs.readFileSync(markerPath, "utf-8");
+	} catch (error) {
+		if (isEnoent(error)) return undefined;
+		return "unreadable";
+	}
+	try {
+		const parsed = JSON.parse(raw) as OriginalEnrollmentMarker;
+		if (typeof parsed?.registryId !== "string" || typeof parsed.ownershipDirectory !== "string") return "unreadable";
+		return parsed;
+	} catch {
+		return "unreadable";
+	}
+}
+
+/**
+ * Refuse any patched-SDK open of a transcript that is durably enrolled unless
+ * the caller arrived with the matching admitted lease.
+ *
+ * The process-local map above only sees writers inside THIS process. A desktop
+ * fork, revive, or branch that spawns a DIFFERENT worker and reaches the
+ * enrolled transcript through an ordinary `SessionManager.open()` /
+ * `forkFrom()` has no lease at all, and the previous owner may already be gone,
+ * so nothing in this process would contend. The marker is what makes that
+ * recognisable from the path alone.
+ *
+ * The marker only ever RESTRICTS. Participation is still granted exclusively by
+ * a registry record minted before the first header, so a forged or copied
+ * marker can cause a refusal but can never manufacture an enrollment. A marker
+ * that exists but cannot be understood fails closed for the same reason.
+ */
+export function assertEnrolledSourceAdmitted(target: string, lease: OriginalWriterLease | undefined): void {
+	const resolved = path.resolve(target);
+	const marker = readOriginalEnrollmentMarker(resolved);
+	if (marker === undefined) return;
+	if (marker === "unreadable") {
+		throw notSubmitted(
+			"enrollment-marker-unreadable",
+			`${resolved} carries an unreadable cooperating enrollment marker; refusing to open it as an ordinary session.`,
+		);
+	}
+	if (lease && lease.originalFile === resolved && lease.registryId === marker.registryId && lease.held) return;
+	throw notSubmitted(
+		"enrolled-source-requires-admission",
+		`${resolved} is a cooperating original (enrollment ${marker.enrollmentId}); it can only be opened through native admission, not as an ordinary session.`,
+	);
+}
+
+/** Publish the durable marker. Called only while the writer lease is held. */
+export function writeOriginalEnrollmentMarker(originalFile: string, marker: OriginalEnrollmentMarker): void {
+	fs.writeFileSync(originalEnrollmentMarkerPath(originalFile), `${JSON.stringify(marker, null, 2)}\n`, {
+		flag: "wx",
+		mode: 0o600,
+	});
+}
+
+/**
+ * A real OS lock held by THIS process for one canonical original transcript,
+ * plus the identity bindings that make the ownership meaningful.
+ *
+ * The stable lock path names a kernel lock on Linux/Windows and a physical
+ * sidecar on other Unix platforms. Physical sidecars are never unlinked.
+ * Locking the transcript itself would lose ownership when an atomic rewrite
+ * replaces its inode. Transcript identity is bound separately and rebound
+ * after each publication this lease performed, so outside swaps are detected.
+ */
+export class OriginalWriterLease {
+	readonly protocol = ORIGINAL_SESSION_OWNERSHIP_PROTOCOL;
+	readonly enrollmentId: string;
+	readonly registryId: string;
+	readonly nativeId: string;
+	/** Canonical (`path.resolve`d) original transcript this lease owns. */
+	readonly originalFile: string;
+	readonly parentDirectory: string;
+	readonly lockPath: string;
+	readonly parentIdentity: NativeNodeIdentity;
+	/** Absent only for the pinned Linux/Windows kernel-name backend. */
+	readonly sidecarIdentity: NativeNodeIdentity | undefined;
+
+	#lock: FileLock | undefined;
+	#identity: NativeNodeIdentity | undefined;
+	#commandId: string | undefined;
+	#released = false;
+
+	private constructor(init: {
+		enrollmentId: string;
+		registryId: string;
+		nativeId: string;
+		originalFile: string;
+		lockPath: string;
+		parentIdentity: NativeNodeIdentity;
+		sidecarIdentity: NativeNodeIdentity | undefined;
+		lock: FileLock;
+	}) {
+		this.enrollmentId = init.enrollmentId;
+		this.registryId = init.registryId;
+		this.nativeId = init.nativeId;
+		this.originalFile = init.originalFile;
+		this.parentDirectory = path.dirname(init.originalFile);
+		this.lockPath = init.lockPath;
+		this.parentIdentity = init.parentIdentity;
+		this.sidecarIdentity = init.sidecarIdentity;
+		this.#lock = init.lock;
+	}
+
+	/**
+	 * Take real OS ownership of `originalFile` through its stable lock path, or refuse
+	 * with a proven no-effect `active-writer`. Nothing is written to the
+	 * transcript and no writable handle is opened here.
+	 */
+	static acquire(init: {
+		enrollmentId: string;
+		registryId: string;
+		nativeId: string;
+		originalFile: string;
+		lockPath: string;
+		expectedParentIdentity: NativeNodeIdentity;
+	}): OriginalWriterLease {
+		const originalFile = path.resolve(init.originalFile);
+		const lockPath = path.resolve(init.lockPath);
+
+		const existing = activeLeases.get(originalFile);
+		if (existing?.held) {
+			throw notSubmitted(
+				"active-writer",
+				`The original session ${originalFile} is already owned by enrollment ${existing.enrollmentId} in this process.`,
+			);
+		}
+
+		const parentIdentity = readNodeIdentity(path.dirname(originalFile));
+		if (!parentIdentity) {
+			throw notSubmitted(
+				"parent-missing",
+				`The directory holding the original session no longer exists: ${path.dirname(originalFile)}`,
+			);
+		}
+		if (!sameNodeIdentity(parentIdentity, init.expectedParentIdentity)) {
+			throw notSubmitted(
+				"parent-retargeted",
+				`The directory holding ${originalFile} was replaced since enrollment; its inode no longer matches the recorded one.`,
+			);
+		}
+
+		let lock: FileLock;
+		try {
+			lock = FileLock.tryAcquire(lockPath);
+		} catch (error) {
+			throw notSubmitted(
+				"lock-unavailable",
+				`Could not attempt the ownership lock at ${lockPath}: ${toError(error).message}`,
+				error,
+			);
+		}
+		if (!lock.acquired) {
+			try {
+				lock.release();
+			} catch {
+				// A handle that never won ownership has nothing to relinquish.
+			}
+			throw notSubmitted(
+				"active-writer",
+				`Another process currently owns the original session ${originalFile} (lock ${lockPath}).`,
+			);
+		}
+
+		// pi-natives 18.1.10 uses kernel names on Linux/Windows, not files.
+		// Select by the pinned backend contract, never by a missing sidecar.
+		const kernelNamed = process.platform === "linux" || process.platform === "win32";
+		const sidecarIdentity = kernelNamed ? undefined : readNodeIdentity(lockPath);
+		if (!kernelNamed && !sidecarIdentity) {
+			try {
+				lock.release();
+			} catch (error) {
+				throw outcomeUnknown(
+					"lease-release-failed",
+					`Acquired the ownership lock at ${lockPath} but it vanished and could not be released.`,
+					error,
+				);
+			}
+			throw notSubmitted("sidecar-missing", `The ownership lock sidecar vanished immediately after acquisition: ${lockPath}`);
+		}
+
+		const lease = new OriginalWriterLease({
+			enrollmentId: init.enrollmentId,
+			registryId: init.registryId,
+			nativeId: init.nativeId,
+			originalFile,
+			lockPath,
+			parentIdentity,
+			sidecarIdentity,
+			lock,
+		});
+		activeLeases.set(originalFile, lease);
+		return lease;
+	}
+
+	get held(): boolean {
+		return !this.#released && this.#lock?.acquired === true;
+	}
+
+	get commandId(): string | undefined {
+		return this.#commandId;
+	}
+
+	/** Bound transcript inode, or undefined before the first header exists. */
+	get boundIdentity(): NativeNodeIdentity | undefined {
+		return this.#identity;
+	}
+
+	view(): OriginalOwnershipView {
+		return {
+			protocol: this.protocol,
+			enrollmentId: this.enrollmentId,
+			registryId: this.registryId,
+			nativeId: this.nativeId,
+			originalFile: this.originalFile,
+			lockPath: this.lockPath,
+			commandId: this.#commandId,
+			held: this.held,
+		};
+	}
+
+	/** Attribute this lease to the admission command that won it. */
+	attachCommand(commandId: string): void {
+		this.#commandId = commandId;
+	}
+
+	/** Pin the reviewed transcript inode so a later swap is detected. */
+	bindIdentity(identity: NativeNodeIdentity): void {
+		this.#identity = { dev: identity.dev, ino: identity.ino };
+	}
+
+	/**
+	 * Gate one write against this lease.
+	 *
+	 * `verifyIdentity` is false for a line appended through an already-open,
+	 * already-validated handle and true whenever a fresh handle is opened or
+	 * the whole file is republished.
+	 */
+	assertWritable(target: string, verifyIdentity: boolean): void {
+		if (this.#released) {
+			throw notSubmitted("ownership-released", `The cooperating lease for ${this.originalFile} was already released.`);
+		}
+		if (!this.#lock?.acquired) {
+			throw notSubmitted("ownership-lost", `This process no longer owns the original session ${this.originalFile}.`);
+		}
+		const resolved = path.resolve(target);
+		if (resolved !== this.originalFile) {
+			throw notSubmitted(
+				"file-mismatch",
+				`A cooperating original manager tried to write ${resolved} while owning ${this.originalFile}.`,
+			);
+		}
+		if (this.sidecarIdentity && !sameNodeIdentity(readNodeIdentity(this.lockPath), this.sidecarIdentity)) {
+			throw notSubmitted(
+				"sidecar-retargeted",
+				`The ownership lock sidecar ${this.lockPath} was replaced while the lease was held.`,
+			);
+		}
+		if (!verifyIdentity) return;
+
+		if (!sameNodeIdentity(readNodeIdentity(this.parentDirectory), this.parentIdentity)) {
+			throw notSubmitted(
+				"parent-retargeted",
+				`The directory holding ${this.originalFile} was replaced while the lease was held.`,
+			);
+		}
+
+		const stats = lstatOrUndefined(this.originalFile);
+		if (!stats) {
+			if (this.#identity) {
+				throw notSubmitted("original-missing", `The owned original session file disappeared: ${this.originalFile}`);
+			}
+			// Pre-first-header: the very next write creates the transcript.
+			return;
+		}
+		assertSafeOriginalTarget(this.originalFile, stats);
+		if (!this.#identity) {
+			this.#identity = { dev: stats.dev, ino: stats.ino };
+			return;
+		}
+		if (this.#identity.dev !== stats.dev || this.#identity.ino !== stats.ino) {
+			throw notSubmitted(
+				"identity-retargeted",
+				`The owned original session file at ${this.originalFile} was replaced by a different inode.`,
+			);
+		}
+	}
+
+	/**
+	 * Adopt the inode published by a rewrite this lease just performed. An
+	 * atomic replace legitimately changes the transcript inode; every other
+	 * inode change stays a retarget.
+	 */
+	noteRepublished(): void {
+		if (!this.held) return;
+		const identity = readNodeIdentity(this.originalFile);
+		if (identity) this.#identity = identity;
+	}
+
+	/**
+	 * Relinquish real OS ownership. Only ever called after a terminal drain
+	 * completed successfully; a failed release is an unknown outcome because
+	 * another writer may or may not now be admissible.
+	 */
+	release(): void {
+		if (this.#released) return;
+		const lock = this.#lock;
+		this.#released = true;
+		this.#lock = undefined;
+		if (activeLeases.get(this.originalFile) === this) activeLeases.delete(this.originalFile);
+		try {
+			lock?.release();
+		} catch (error) {
+			logger.error("Failed to release a cooperating original-session lease", {
+				originalFile: this.originalFile,
+				lockPath: this.lockPath,
+				error: toError(error).message,
+			});
+			throw outcomeUnknown(
+				"lease-release-failed",
+				`The cooperating lease for ${this.originalFile} could not be released; another writer may or may not be admissible.`,
+				error,
+			);
+		}
+	}
+}
