+	const { binding, source, commandId } = options;
+	assertBindingShape(binding);
+	assertSourceShape(source);
+	if (typeof commandId !== "string" || commandId.length === 0) {
+		throw notSubmitted("invalid-command", "An admission requires a command id to attribute ownership to.");
+	}
