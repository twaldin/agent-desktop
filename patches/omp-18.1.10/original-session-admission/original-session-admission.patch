+
+function prepareOwnershipDirectory(ownershipDirectory: string): void {
+	for (const directory of [RECORDS_DIRECTORY, FILES_DIRECTORY, LEASES_DIRECTORY]) {
+		fs.mkdirSync(path.join(ownershipDirectory, directory), { recursive: true, mode: 0o700 });
+	}
+	const markerPath = path.join(ownershipDirectory, PROTOCOL_MARKER);
+	const marker = readJsonFile(markerPath) as { protocol?: number } | undefined;
+	if (marker) {
+		if (marker.protocol === ORIGINAL_SESSION_OWNERSHIP_PROTOCOL) return;
+		throw notSubmitted(
+			"protocol-mismatch",
+			`${ownershipDirectory} holds ownership protocol ${marker.protocol}; this build speaks ${ORIGINAL_SESSION_OWNERSHIP_PROTOCOL}.`,
+		);
+	}
+	try {
+		fs.writeFileSync(markerPath, `${JSON.stringify({ protocol: ORIGINAL_SESSION_OWNERSHIP_PROTOCOL })}\n`, {
+			flag: "wx",
+			mode: 0o600,
+		});
+	} catch (error) {
+		// A concurrent cooperating writer claimed the same generation first.
+		if (!hasCode(error, "EEXIST")) throw error;
+	}
+}
+
+/**
+ * Undo a partially written enrollment. The original never existed and no
+ * header was published, so a clean unwind keeps the refusal a proven
+ * no-effect one; a failed unwind must not be reported as such.
+ */
+function unwindEnrollment(
+	ownershipDirectory: string,
+	registryId: string,
+	originalFile: string,
+	lease: OriginalWriterLease,
+	written: { record: boolean; index: boolean; marker: boolean },
+	cause: unknown,
+): never {
+	const cleanupFailures: Error[] = [];
+	const remove = (target: string) => {
+		try {
+			fs.rmSync(target);
+		} catch (error) {
+			if (!isEnoent(error)) cleanupFailures.push(toError(error));
+		}
+	};
+	if (written.marker) remove(originalEnrollmentMarkerPath(originalFile));
+	if (written.index) remove(fileIndexPath(ownershipDirectory, originalFile));
+	if (written.record) remove(recordPath(ownershipDirectory, registryId));
+	try {
+		lease.release();
+	} catch (error) {
+		cleanupFailures.push(toError(error));
+	}
+	if (cleanupFailures.length > 0) {
+		throw outcomeUnknown(
+			"enrollment-cleanup-failed",
+			`A rejected enrollment for registry ${registryId} could not be fully unwound: ${cleanupFailures
+				.map(failure => failure.message)
+				.join("; ")}`,
+			cause,
+		);
+	}
+	throw cause;
+}
+
+/**
