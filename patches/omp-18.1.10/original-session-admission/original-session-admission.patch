+/**
+ * Durable proof that one native original transcript was created by a known
+ * cooperating writer under this protocol generation.
+ *
+ * A binding is minted exactly once, by {@link createCooperativeOriginal},
+ * before that original's first header reaches disk. It is never derived from
+ * an observation of an already-existing transcript: an unknown stock original
+ * has no binding and can never acquire one retrospectively.
+ */
+export interface NativeOriginalBinding {
+    protocol: typeof ORIGINAL_SESSION_OWNERSHIP_PROTOCOL;
+    enrollmentId: string;
+    registryId: string;
+    originalFile: string;
+    nativeId: string;
+    recordedCwd: string;
+    canonicalCwd: string;
+}
+/**
+ * The reviewed state of an original transcript at the moment a caller decided
+ * to admit it. Structurally the native half of the host's reviewed session
+ * source, which additionally carries the UI candidate id and revision.
+ *
+ * Every field is revalidated under real ownership before a writable open.
+ */
+export interface NativeOriginalSource {
+    originalFile: string;
+    nativeId: string;
+    recordedCwd: string;
+    canonicalCwd: string;
+    contentSha256: string;
+    fileIdentity: NativeFileIdentity;
+}
+export type OriginalParticipation = {
+    ok: true;
+    binding: NativeOriginalBinding;
+} | {
+    ok: false;
+    reason: string;
+    message: string;
+};
+/**
+ * Decide whether a reviewed original participates in the cooperating regime.
+ *
+ * Strictly readonly: no directory is created, no lock is attempted, and no
+ * native session is opened. A refusal is a value rather than a throw, because
+ * a non-participating original is an ordinary answer, not a failure.
+ */
+export declare function inspectOriginalParticipation(ownershipDirectory: string, source: NativeOriginalSource): Promise<OriginalParticipation>;
+/**
+ * Re-observe an enrolled original without taking ownership.
+ *
+ * Deliberately performs no directory migration, no header rewrite and no
+ * writable open: callers use this to refresh a reviewed source before a later
+ * admission, and an observation that mutated the original would destroy the
+ * very identity it reports.
+ */
+export declare function observeEnrolledOriginal(ownershipDirectory: string, binding: NativeOriginalBinding): Promise<NativeOriginalSource>;
+/**
+ * Create a brand-new original that participates in the cooperating regime.
+ *
+ * Ownership and the enrollment record are established BEFORE the first header
+ * is published, which is what makes the resulting provenance meaningful: the
+ * regime is a property of how the transcript was born, never a marker that can
+ * be stamped onto an unknown stock transcript later.
+ */
+export declare function createCooperativeOriginal(options: {
+    ownershipDirectory: string;
+    cwd: string;
+    sessionDirectory: string;
+}): Promise<{
+    manager: SessionManager;
+    binding: NativeOriginalBinding;
+}>;
+/**
+ * Take real writer-process ownership of an already-enrolled original and open
+ * it as the exact native session it already is.
+ *
+ * Ordering is the whole contract: the OS lock is taken first, every reviewed
+ * fact is revalidated while it is held, and only then does a writable open
+ * happen. A refusal before that open is therefore proven to have had no
+ * effect; anything that fails afterwards is an unknown outcome and says so.
+ */
+export declare function openAdmittedOriginal(options: {
+    ownershipDirectory: string;
+    binding: NativeOriginalBinding;
+    source: NativeOriginalSource;
+    commandId: string;
+}): Promise<SessionManager>;
