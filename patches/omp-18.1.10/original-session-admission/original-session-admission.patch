+		return { ok: true, binding: bindingFor(record) };
+	} catch (error) {
+		if (error instanceof OriginalSessionNotSubmittedError) {
+			return { ok: false, reason: error.reason, message: error.message };
+		}
+		return { ok: false, reason: "inspection-failed", message: toError(error).message };
+	}
