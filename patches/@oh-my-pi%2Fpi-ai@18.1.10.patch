diff --git a/src/auth/reset-account-evidence.ts b/src/auth/reset-account-evidence.ts
new file mode 100755
index 0000000..89404e4
--- /dev/null
+++ b/src/auth/reset-account-evidence.ts
@@ -0,0 +1,59 @@
+import { createHash } from "node:crypto";
+import type { AuthCredential, ResetAccountEvidence } from "../auth-storage";
+
+const scopeKeys = ["accountId", "email", "projectId", "orgId"] as const;
+const text = (value: unknown): string | undefined => typeof value === "string" && value.trim().length > 0 ? value : undefined;
+
+/** Internal constructor: only the backend supplies durable namespace/incarnation, never token bytes. */
+export function createResetAccountEvidence(
+	authAuthority: string,
+	incarnation: string,
+	provider: string,
+	credentialId: number,
+	credential: AuthCredential,
+): ResetAccountEvidence | undefined {
+	if (credential.type !== "oauth" || !provider || !Number.isSafeInteger(credentialId) || credentialId < 1 ||
+		!authAuthority || authAuthority.length > 256 || /[\u0000-\u001f]/.test(authAuthority) || !/^[a-f0-9]{32}$/.test(incarnation)) return undefined;
+	const accountId = text(credential.accountId), email = text(credential.email);
+	if (!accountId && !email) return undefined;
+	const projectId = text(credential.projectId), orgId = text(credential.orgId);
+	const credentialFingerprint = createHash("sha256").update(JSON.stringify([
+		"reset-account-evidence-v1", authAuthority, incarnation, provider, credentialId,
+		accountId ?? null, email ?? null, projectId ?? null, orgId ?? null,
+	])).digest("hex");
+	return Object.freeze({ version: 1, provider, credentialId, authAuthority, credentialFingerprint,
+		...(accountId ? { accountId } : {}), ...(email ? { email } : {}),
+		...(projectId ? { projectId } : {}), ...(orgId ? { orgId } : {}) });
+}
+
+/** Checks the native reset identity slice, excluding cosmetic org names and bearer data. */
+export function matchesResetAccountCredential(
+	evidence: ResetAccountEvidence | undefined,
+	provider: string,
+	credentialId: number,
+	credential: AuthCredential,
+): evidence is ResetAccountEvidence {
+	return evidence != null && evidence.version === 1 && credential.type === "oauth" &&
+		evidence.provider === provider && evidence.credentialId === credentialId &&
+		typeof evidence.authAuthority === "string" && evidence.authAuthority.length > 0 && evidence.authAuthority.length <= 256 &&
+		!/[\u0000-\u001f]/.test(evidence.authAuthority) &&
+		typeof evidence.credentialFingerprint === "string" && /^[a-f0-9]{64}$/.test(evidence.credentialFingerprint) &&
+		!!(text(evidence.accountId) || text(evidence.email)) &&
+		scopeKeys.every(key => evidence[key] === text(credential[key]));
+}
+
+/** Missing/unsupported evidence is never equivalent, including two missing values. */
+export function sameResetAccountEvidence(left: ResetAccountEvidence | undefined, right: ResetAccountEvidence | undefined): boolean {
+	return left != null && right != null && left.version === 1 && right.version === 1 &&
+		left.provider === right.provider && left.credentialId === right.credentialId &&
+		left.authAuthority === right.authAuthority && left.credentialFingerprint === right.credentialFingerprint &&
+		scopeKeys.every(key => left[key] === right[key]);
+}
+
+/** Whitelisted detached value: never spread an extension/backing-store object into a public proof. */
+export function snapshotResetAccountEvidence(evidence: ResetAccountEvidence): ResetAccountEvidence {
+	return Object.freeze({ version: evidence.version, provider: evidence.provider, credentialId: evidence.credentialId,
+		authAuthority: evidence.authAuthority, credentialFingerprint: evidence.credentialFingerprint,
+		...(evidence.accountId ? { accountId: evidence.accountId } : {}), ...(evidence.email ? { email: evidence.email } : {}),
+		...(evidence.projectId ? { projectId: evidence.projectId } : {}), ...(evidence.orgId ? { orgId: evidence.orgId } : {}) });
+}
